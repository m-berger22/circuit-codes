/-- the word, by position -/
def famT (κ h p : ℕ) : ℕ :=
  famG (3 * κ + h + 1) (2 * κ + 1) (3 * κ + 1) (2 * κ + 1 + h) (2 * h + 1) (2 * h) 1 (2 * κ + 2) (2 * κ + 3) (4 * κ + 4)
    (4 * κ + 2 * h + 5) (4 * κ + 6 * h + 5) (6 * κ + 2 * h + 5) (6 * κ + 2 * h + 6) (6 * κ + 6 * h + 6) p

/-- all cases of `famT` (16 alternatives; `split_ifs` loops on `famT`, so everything goes through this lemma) -/
lemma famT_cases (κ h p : ℕ) (hh : 2 * h ≤ κ) :
    (p = 0 ∧ famT κ h p = 3 * κ + h + 1)
    ∨ (1 ≤ p ∧ p < 2 * κ + 2 ∧ famT κ h p + 1 = p)
    ∨ (p = 2 * κ + 2 ∧ famT κ h p = 3 * κ + h + 1)
    ∨ (2 * κ + 3 ≤ p ∧ p < 4 * κ + 4 ∧ (p - (2 * κ + 3)) % 2 = 0 ∧ famT κ h p = p - (2 * κ + 3))
    ∨ (2 * κ + 3 ≤ p ∧ p < 4 * κ + 4 ∧ (p - (2 * κ + 3)) % 2 = 1 ∧ famT κ h p = 2 * κ + 1 + (p - (2 * κ + 3)) / 2)
    ∨ (4 * κ + 4 ≤ p ∧ p < 4 * κ + 2 * h + 5 ∧ famT κ h p = p - (4 * κ + 4))
    ∨ (4 * κ + 2 * h + 5 ≤ p ∧ p < 4 * κ + 6 * h + 5 ∧ (p - (4 * κ + 2 * h + 5)) % 4 = 0 ∧ famT κ h p = 3 * κ + 1 + (p - (4 * κ + 2 * h + 5)) / 4)
    ∨ (4 * κ + 2 * h + 5 ≤ p ∧ p < 4 * κ + 6 * h + 5 ∧ (p - (4 * κ + 2 * h + 5)) % 4 = 1 ∧ famT κ h p = 2 * κ + 1 + h + (p - (4 * κ + 2 * h + 5)) / 4)
    ∨ (4 * κ + 2 * h + 5 ≤ p ∧ p < 4 * κ + 6 * h + 5 ∧ (p - (4 * κ + 2 * h + 5)) % 4 = 2 ∧ famT κ h p = 2 * h + 1 + 2 * ((p - (4 * κ + 2 * h + 5)) / 4))
    ∨ (4 * κ + 2 * h + 5 ≤ p ∧ p < 4 * κ + 6 * h + 5 ∧ (p - (4 * κ + 2 * h + 5)) % 4 = 3 ∧ famT κ h p = 2 * h + 1 + 2 * ((p - (4 * κ + 2 * h + 5)) / 4) + 1)
    ∨ (4 * κ + 6 * h + 5 ≤ p ∧ p < 6 * κ + 2 * h + 5 ∧ famT κ h p = p + 1 - (4 * κ + 2 * h + 5))
    ∨ (p = 6 * κ + 2 * h + 5 ∧ famT κ h p = 3 * κ + h + 1)
    ∨ (6 * κ + 2 * h + 6 ≤ p ∧ p < 6 * κ + 6 * h + 6 ∧ (p - (6 * κ + 2 * h + 6)) % 4 = 0 ∧ famT κ h p = 2 * ((p - (6 * κ + 2 * h + 6)) / 4))
    ∨ (6 * κ + 2 * h + 6 ≤ p ∧ p < 6 * κ + 6 * h + 6 ∧ (p - (6 * κ + 2 * h + 6)) % 4 = 1 ∧ famT κ h p = 2 * κ + 1 + h + (p - (6 * κ + 2 * h + 6)) / 4)
    ∨ (6 * κ + 2 * h + 6 ≤ p ∧ p < 6 * κ + 6 * h + 6 ∧ (p - (6 * κ + 2 * h + 6)) % 4 = 2 ∧ famT κ h p = 2 * ((p - (6 * κ + 2 * h + 6)) / 4) + 1)
    ∨ (6 * κ + 2 * h + 6 ≤ p ∧ p < 6 * κ + 6 * h + 6 ∧ (p - (6 * κ + 2 * h + 6)) % 4 = 3 ∧ famT κ h p = 2 * κ + 1 + (p - (6 * κ + 2 * h + 6)) / 4)
    ∨ (6 * κ + 6 * h + 6 ≤ p ∧ famT κ h p = 2 * h) := by
  have := famG_cases (3 * κ + h + 1) (2 * κ + 1) (3 * κ + 1) (2 * κ + 1 + h) (2 * h + 1) (2 * h) 1 (2 * κ + 2) (2 * κ + 3)
    (4 * κ + 4) (4 * κ + 2 * h + 5) (4 * κ + 6 * h + 5) (6 * κ + 2 * h + 5) (6 * κ + 2 * h + 6) (6 * κ + 6 * h + 6) p
    (by omega) (by omega) (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
  rw [← famT] at this
  rcases this with c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c
  · left; refine ⟨?_, ?_⟩ <;> omega
  · (iterate 1 right); left; refine ⟨?_, ?_, ?_⟩ <;> omega
  · (iterate 2 right); left; refine ⟨?_, ?_⟩ <;> omega
  · (iterate 3 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 4 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 5 right); left; refine ⟨?_, ?_, ?_⟩ <;> omega
  · (iterate 6 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 7 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 8 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 9 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 10 right); left; refine ⟨?_, ?_, ?_⟩ <;> omega
  · (iterate 11 right); left; refine ⟨?_, ?_⟩ <;> omega
  · (iterate 12 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 13 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 14 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 15 right); left; refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · (iterate 16 right); refine ⟨?_, ?_⟩ <;> omega

lemma famT_lt {κ h : ℕ} (hh : 2 * h ≤ κ) (p : ℕ) : famT κ h p < 3 * κ + h + 2 := by
  rcases famT_cases κ h p hh with c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c <;> omega

/-- the word with letters in `Fin (3κ + h + 2)` -/
def famF (κ h : ℕ) (hh : 2 * h ≤ κ) : ℕ → Fin (3 * κ + h + 2) :=
  fun p => ⟨famT κ h p, famT_lt hh p⟩

lemma famF_eq_iff {κ h : ℕ} (hh : 2 * h ≤ κ) (i j : ℕ) :
    famF κ h hh i = famF κ h hh j ↔ famT κ h i = famT κ h j := by
  simp [famF, Fin.ext_iff]

/-! ### down-step predicate (Sign Table); `x`, `y`, `w` = offsets in the blocks z'B, C z'', D -/

def dnB (s x : ℕ) : Prop := if x = 0 then s = 0 else if x % 2 = 1 then s ≤ x else False

def dnC (K m s y : ℕ) : Prop :=
  if y < m then (if y % 2 = 0 then (y + 1 < s ∧ s ≤ K + 2 + y) else s ≤ y + 1)
  else if y + 2 < 3 * m then
    (if (y - m) % 4 = 0 then False
     else if (y - m) % 4 = 1 then s ≤ K + m + 2 + 2 * ((y - m) / 4)
     else if (y - m) % 4 = 2 then s ≤ m + 2 * ((y - m) / 4) + 1
     else (m + 2 * ((y - m) / 4) + 2 < s ∧ s ≤ K + m + 2 * ((y - m) / 4) + 3))
  else if y + 1 < K + m then (if y % 2 = 0 then (y + 2 < s + m ∧ s + m ≤ K + 3 + y) else s + m ≤ y + 2)
  else (0 < s ∧ s ≤ K + 1)

def dnD (K m s w : ℕ) : Prop :=
  if w % 4 = 0 then (s ≤ 2 * (w / 4) + 1 ∨ (K + 2 + 2 * (w / 4) < s ∧ s ≤ 2 * K + 2 + 2 * (w / 4)))
  else if w % 4 = 1 then (K + m + 2 + 2 * (w / 4) < s ∧ s ≤ 2 * K + m + 3 + 4 * (w / 4))
  else if w % 4 = 2 then (2 * (w / 4) + 2 < s ∧ s ≤ 2 * K + 3 + 2 * (w / 4))
  else s ≤ K + 3 + 2 * (w / 4)

def dn (κ h s j : ℕ) : Prop :=
  (2 * κ + 2 ≤ j ∧ j < 4 * κ + 4 ∧ dnB s (j - (2 * κ + 2)))
  ∨ (4 * κ + 4 ≤ j ∧ j < 6 * κ + 2 * h + 6 ∧ dnC (2 * κ + 1) (2 * h + 1) s (j - (4 * κ + 4)))
  ∨ (6 * κ + 2 * h + 6 ≤ j ∧ dnD (2 * κ + 1) (2 * h + 1) s (j - (6 * κ + 2 * h + 6)))

lemma dn_A {κ h s j : ℕ} (hj : j < 2 * κ + 2) : ¬ dn κ h s j := by
  unfold dn; omega

lemma dn_B {κ h s j : ℕ} (h1 : 2 * κ + 2 ≤ j) (h2 : j < 4 * κ + 4) : dn κ h s j ↔ dnB s (j - (2 * κ + 2)) := by
  unfold dn
  constructor
  · rintro (⟨_, _, h⟩ | ⟨_, _, _⟩ | ⟨_, _⟩)
    · exact h
    · omega
    · omega
  · intro h; exact Or.inl ⟨h1, h2, h⟩

lemma dn_C {κ h s j : ℕ} (h1 : 4 * κ + 4 ≤ j) (h2 : j < 6 * κ + 2 * h + 6) :
    dn κ h s j ↔ dnC (2 * κ + 1) (2 * h + 1) s (j - (4 * κ + 4)) := by
  unfold dn
  constructor
  · rintro (⟨_, _, _⟩ | ⟨_, _, h⟩ | ⟨_, _⟩)
    · omega
    · exact h
    · omega
  · intro h; exact Or.inr (Or.inl ⟨h1, h2, h⟩)

lemma dn_D {κ h s j : ℕ} (h1 : 6 * κ + 2 * h + 6 ≤ j) :
    dn κ h s j ↔ dnD (2 * κ + 1) (2 * h + 1) s (j - (6 * κ + 2 * h + 6)) := by
  unfold dn
  constructor
  · rintro (⟨_, _, _⟩ | ⟨_, _, _⟩ | ⟨_, h⟩)
    · omega
    · omega
    · exact h
  · intro h; exact Or.inr (Or.inr ⟨h1, h⟩)

/-! ### height function.  `s ≤ K`: start in z or A; `sp = s - (K+1) ≤ K`: start in z' or B; `u = s - (2K+2)`: in C -/

def HBA (K s x : ℕ) : ℕ :=
  if x ≤ s then K + 1 + x - s else if s = 0 then K - (x + 1) % 2 else K + 1 + (s + 1) % 2 - (x + 1) % 2

def HCA (K m s y : ℕ) : ℕ :=
  if s = 0 then
    (if y < m then K - (y + 1) % 2
     else if y + 2 < 3 * m then K + 1 + (y - m) % 4 % 2 - 2 * ((y - m) % 4 / 3) - 1
     else if y < K + m then K - (y + 1) % 2
     else K + 1)
  else if y < m then
    (if y % 2 = 1 then (if y + 1 < s then K + (s + 1) % 2 - 1 else K + 1 - (s + 1) % 2)
     else (if y < s then K + (s + 1) % 2 else K - (s + 1) % 2))
  else if y + 2 < 3 * m then
    (if m + 2 * ((y - m) / 4) + 1 < s then K + (s + 1) % 2 + (y - m) % 4 % 2 - 1
     else K + 1 + (1 + (y - m) % 4 % 2) - 2 * ((y - m) % 4 / 3) - ((s + 1) % 2 + 1))
  else if y < K + m then
    (if y % 2 = 1 then (if y + 3 ≤ s + m then K + (s + 1) % 2 - 1 else K + 1 - (s + 1) % 2)
     else (if y + 2 ≤ s + m then K + (s + 1) % 2 else K - (s + 1) % 2))
  else K - (s + 1) % 2

def HDA (K m s w : ℕ) : ℕ :=
  if s = 0 then
    (if w + 2 < 2 * m then K + 1 + (1 + 2 * (w % 4 / 3)) - (w % 4 % 2 + 1)
     else if w + 2 = 2 * m then K + 1
     else K)
  else if w + 2 < 2 * m then
    (if 2 * (w / 4) + 2 < s then K + w % 4 - 2 * (w % 4 / 3) - (s + 1) % 2
     else if 2 * (w / 4) + 2 = s then K + w % 4 - 1
     else K + (s + 1) % 2 + (1 + 2 * (w % 4 / 3)) - w % 4 % 2 - 1)
  else if w + 2 = 2 * m then (if (s + 1) % 2 = 0 then K else if s ≤ m then K + 1 else K - 1)
  else (if (s + 1) % 2 = 0 then (if s ≤ m then K - 1 else K + 1) else K)

def EC (K m sp : ℕ) : ℕ :=
  if sp ≤ m then K + (sp + 1) % 2 - 1 else if sp ≤ 2 * m then K + sp - (m + 1) else K + m + (sp + 1) % 2 - 2

def HCB (K m sp y : ℕ) : ℕ :=
  if sp = 0 then
    (if y < m then K + (y + 1) % 2
     else if y + 2 < 3 * m then K + (y - m) % 4 % 2
     else if y < K + m then K + (y + 1) % 2
     else K - 1)
  else if y < m then
    (if y % 2 = 1 then (if y + 2 < sp then K + y + 1 - sp else EC K m sp)
     else (if y + 1 < sp then K + y + 1 - sp else EC K m sp + 1))
  else if y + 2 < 3 * m then
    (if sp ≤ m + 2 * ((y - m) / 4) + 1 then EC K m sp + (y - m) % 4 % 2
     else if sp = m + 2 * ((y - m) / 4) + 2 then K + sp + (y - m) % 4 - (m + 3)
     else K + y + 1 - sp)
  else if y < K + m then
    (if y % 2 = 1 then (if y + 3 < sp + m then K + y + 1 - sp else EC K m sp)
     else (if y + 2 < sp + m then K + y + 1 - sp else EC K m sp + 1))
  else EC K m sp + 1

def HDB (K m sp w : ℕ) : ℕ :=
  if sp = 0 then
    (if w + 2 < 2 * m then K + w % 4 - 2 * (w % 4 / 3) - 1
     else if w + 2 = 2 * m then K - 1
     else K)
  else if w + 2 < 2 * m then
    (if sp ≤ 2 * (w / 4) + 1 then K + w % 4 - 2 * (w % 4 / 3) - (sp + 1) % 2
     else if sp = 2 * (w / 4) + 2 then K + 1 - w % 4 % 2
     else if sp ≤ m + 2 * (w / 4) + 1 then K + (sp + 1) % 2 - w % 4 % 2
     else EC K m sp + 1 - (2 * (w / 4) + w % 4))
  else if w + 2 = 2 * m then (if sp ≤ m then K - (sp + 1) % 2 else K + (sp + 1) % 2)
  else (if sp ≤ m then K + 1 - (sp + 1) % 2 else K + (sp + 1) % 2 - 1)

def HDC (K m u w : ℕ) : ℕ :=
  if w + 2 < 2 * m then
    (if u ≤ 2 * (w / 4) then K + m + u - (2 * (w / 4) + w % 4)
     else if u = 2 * (w / 4) + 1 then K + m + (1 + w % 4 % 2) - 2 * (w % 4 / 3) - 2
     else if u ≤ m + 4 * (w / 4) + 1 then K + m + 2 * (w / 4) + 2 * min (m / 2) ((u + 2 - m) / 4) + w % 4 % 2 - u
     else K + m + w - u)
  else if w + 2 = 2 * m then
    (if u + 1 ≤ m then K + u + 1 else K + 2 * m + 2 * min (m / 2) ((u + 2 - m) / 4) - (u + 1))
  else (if u + 1 ≤ m then K + u else K + 2 * m + 2 * min (m / 2) ((u + 2 - m) / 4) - u)

def H (κ h s p : ℕ) : ℕ :=
  if s ≤ 2 * κ + 1 then
    (if p ≤ 2 * κ + 2 then p - s
     else if p ≤ 4 * κ + 4 then HBA (2 * κ + 1) s (p - (2 * κ + 2))
     else if p ≤ 6 * κ + 2 * h + 6 then HCA (2 * κ + 1) (2 * h + 1) s (p - (4 * κ + 4))
     else HDA (2 * κ + 1) (2 * h + 1) s (p - (6 * κ + 2 * h + 6)))
  else if s ≤ 4 * κ + 3 then
    (if p ≤ 4 * κ + 4 then p - s
     else if p ≤ 6 * κ + 2 * h + 6 then HCB (2 * κ + 1) (2 * h + 1) (s - (2 * κ + 2)) (p - (4 * κ + 4))
     else HDB (2 * κ + 1) (2 * h + 1) (s - (2 * κ + 2)) (p - (6 * κ + 2 * h + 6)))
  else if s ≤ 6 * κ + 2 * h + 4 then
    (if p ≤ 6 * κ + 2 * h + 6 then p - s
     else HDC (2 * κ + 1) (2 * h + 1) (s - (4 * κ + 4)) (p - (6 * κ + 2 * h + 6)))
  else p - s

/-! ### from occurrences to the parity of the count -/

lemma odd3 (A B C : Prop) [Decidable A] [Decidable B] [Decidable C] :
    Odd ((if A then 1 else 0) + (if B then 1 else 0) + (if C then 1 else 0))
      ↔ ((A ∧ ¬ B ∧ ¬ C) ∨ (¬ A ∧ B ∧ ¬ C) ∨ (¬ A ∧ ¬ B ∧ C) ∨ (A ∧ B ∧ C)) := by
  by_cases a : A <;> by_cases b : B <;> by_cases c : C <;> simp [a, b, c] <;> decide

/-- one row of the Sign Table: letter value `v` at `j`, earlier occurrences among `p1, p2, p3` (dummies `≥ j`). -/
lemma hdn_of {κ h : ℕ} (hh : 2 * h ≤ κ) {s j v p1 p2 p3 : ℕ} (hsj : s ≤ j)
    (hv : famT κ h j = v)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1 ∨ i = p2 ∨ i = p3))
    (h12 : p1 ≠ p2) (h13 : p1 ≠ p3) (h23 : p2 ≠ p3)
    (hD : dn κ h s j ↔ (((s ≤ p1 ∧ p1 < j) ∧ ¬ (s ≤ p2 ∧ p2 < j) ∧ ¬ (s ≤ p3 ∧ p3 < j))
      ∨ (¬ (s ≤ p1 ∧ p1 < j) ∧ (s ≤ p2 ∧ p2 < j) ∧ ¬ (s ≤ p3 ∧ p3 < j))
      ∨ (¬ (s ≤ p1 ∧ p1 < j) ∧ ¬ (s ≤ p2 ∧ p2 < j) ∧ (s ≤ p3 ∧ p3 < j))
      ∨ ((s ≤ p1 ∧ p1 < j) ∧ (s ≤ p2 ∧ p2 < j) ∧ (s ≤ p3 ∧ p3 < j)))) :
    Odd (cnt (famF κ h hh) s (j - s) (famF κ h hh j)) ↔ dn κ h s j := by
  have e : s + (j - s) = j := by omega
  have hc := cnt_three (T := famF κ h hh) (s := s) (w := j - s) (c := famF κ h hh j) h12 h13 h23
    (by
      intro i _ hi
      rw [famF_eq_iff, hv]
      exact hocc i (by omega))
  rw [hc, e, hD, odd3]

/-! ### step lemmas, one per (block of s, block of j)   (generated by a script) -/

lemma stepBA {K s x : ℕ} (hK : K % 2 = 1) (hs : s ≤ K) (hx : x ≤ K) :
    (¬ dnB s x → HBA K s (x + 1) = HBA K s x + 1)
      ∧ (dnB s x → K ≤ HBA K s x ∧ HBA K s (x + 1) + 1 = HBA K s x) := by
  unfold dnB HBA
  split_ifs <;> first | omega | contradiction | (simp only [not_false_eq_true, false_imp_iff, true_imp_iff, and_true] <;> omega)

end FamOdd

