lemma trans_z4 {μ x : ℕ} (h1 : 8 * (μ + 3) ≤ x) (h2 : x < 10 * (μ + 3)) : Trans (μ + 3) x := by
  have hn : x = 8 * (μ + 3) ∨ x = 8 * (μ + 3) + 1 ∨ x = 8 * (μ + 3) + 2 ∨ x = 8 * (μ + 3) + 3 ∨ (8 * (μ + 3) + 4 ≤ x ∧ x + 3 ≤ 10 * (μ + 3)) ∨ x + 2 = 10 * (μ + 3) ∨ x + 1 = 10 * (μ + 3) := by omega
  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z4_p0 hn
  · exact tr_z4_p1 hn
  · exact tr_z4_p2 hn
  · exact tr_z4_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 8 * (μ + 3)) with hp | hp
    · exact tr_z4_ge (n := (x - 8 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z4_go (n := (x - 8 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z4_gt (by omega)
  · exact tr_z4_l (by omega)

