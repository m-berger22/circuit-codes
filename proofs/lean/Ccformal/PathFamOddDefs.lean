/-- the word with generic block boundaries (`split_ifs` / `rw` are pathologically slow on the explicit boundaries
`2κ+2, 2κ+3, …` because of Nat-literal unification, hence this detour) -/
def famG (z K nN nn mm e a1 a2 a3 a4 a5 a6 a7 a8 a9 p : ℕ) : ℕ :=
  if p < a1 then z
  else if p < a2 then p - a1
  else if p < a3 then z
  else if p < a4 then (if (p - a3) % 2 = 0 then p - a3 else K + (p - a3) / 2)
  else if p < a5 then p - a4
  else if p < a6 then
    (if (p - a5) % 4 = 0 then nN + (p - a5) / 4
     else if (p - a5) % 4 = 1 then nn + (p - a5) / 4
     else if (p - a5) % 4 = 2 then mm + 2 * ((p - a5) / 4)
     else mm + 2 * ((p - a5) / 4) + 1)
  else if p < a7 then p - a5 + 1
  else if p < a8 then z
  else if p < a9 then
    (if (p - a8) % 4 = 0 then 2 * ((p - a8) / 4)
     else if (p - a8) % 4 = 1 then nn + (p - a8) / 4
     else if (p - a8) % 4 = 2 then 2 * ((p - a8) / 4) + 1
     else K + (p - a8) / 4)
  else e

set_option maxHeartbeats 1000000 in
lemma famG_cases (z K nN nn mm e a1 a2 a3 a4 a5 a6 a7 a8 a9 p : ℕ) (h12 : a1 ≤ a2) (h23 : a2 ≤ a3) (h34 : a3 ≤ a4)
