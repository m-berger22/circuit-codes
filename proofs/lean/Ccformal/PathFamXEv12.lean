    Nc (μ + 3) (20 * (μ + 3) + 1) p = (μ + 3) ∧
    Nc (μ + 3) (22 * (μ + 3)) p = (μ + 3) ∧
    Nc (μ + 3) (22 * (μ + 3) + 1) p = (μ + 3) := by
