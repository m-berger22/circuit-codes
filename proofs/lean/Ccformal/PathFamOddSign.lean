variable {κ h : ℕ}

lemma hdn_of0 (hh : 2 * h ≤ κ) {s j v : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v)
    (hocc : ∀ i, i < j → famT κ h i ≠ v) (hD : ¬ dn κ h s j) :
    Odd (cnt (famF κ h hh) s (j - s) ((famF κ h hh) j)) ↔ dn κ h s j := by
  refine hdn_of hh hsj hv (p1 := j + 1) (p2 := j + 2) (p3 := j + 3)
    (fun i hi => ⟨fun e => absurd e (hocc i hi), fun e => by omega⟩) (by omega) (by omega) (by omega) ?_
  constructor
  · intro hd; exact absurd hd hD
  · intro hp; exfalso; omega

lemma hdn_of1 (hh : 2 * h ≤ κ) {s j v p1 : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v) (hp1 : p1 < j)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1)) (hD : dn κ h s j ↔ s ≤ p1) :
    Odd (cnt (famF κ h hh) s (j - s) ((famF κ h hh) j)) ↔ dn κ h s j := by
  refine hdn_of hh hsj hv (p1 := p1) (p2 := j + 2) (p3 := j + 3)
    (fun i hi => by rw [hocc i hi]; omega) (by omega) (by omega) (by omega) ?_
  rw [hD]; omega

lemma hdn_of2 (hh : 2 * h ≤ κ) {s j v p1 p2 : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v) (hp1 : p1 < j)
    (hp2 : p2 < p1)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1 ∨ i = p2)) (hD : dn κ h s j ↔ (p2 < s ∧ s ≤ p1)) :
    Odd (cnt (famF κ h hh) s (j - s) ((famF κ h hh) j)) ↔ dn κ h s j := by
  refine hdn_of hh hsj hv (p1 := p1) (p2 := p2) (p3 := j + 3)
    (fun i hi => by rw [hocc i hi]; omega) (by omega) (by omega) (by omega) ?_
  rw [hD]; omega

lemma hdn_of3 (hh : 2 * h ≤ κ) {s j v p1 p2 p3 : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v) (hp1 : p1 < j)
    (hp2 : p2 < p1) (hp3 : p3 < p2)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1 ∨ i = p2 ∨ i = p3))
    (hD : dn κ h s j ↔ ((p2 < s ∧ s ≤ p1) ∨ s ≤ p3)) :
    Odd (cnt (famF κ h hh) s (j - s) ((famF κ h hh) j)) ↔ dn κ h s j := by
  refine hdn_of hh hsj hv (p1 := p1) (p2 := p2) (p3 := p3) hocc (by omega) (by omega) (by omega) ?_
  rw [hD]; omega

lemma row_Z0 (hh : 2 * h ≤ κ) {s j : ℕ} (hj : j = 0)  (hsj : s ≤ j) :
    Odd (cnt (famF κ h hh) s (j - s) ((famF κ h hh) j)) ↔ dn κ h s j := by
  subst hj
  refine hdn_of0 hh hsj (v := 3 * κ + h + 1)  ?_  ?_ ?_
  · rcases famT_cases κ h (0) hh with c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c <;> omega
  · intro i hi
    rcases famT_cases κ h i hh with c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c | c <;> omega
  · exact dn_A (by omega)

