lemma pbr_2_l_11 {μ s p : ℕ} (h : s + 1 = 6 * (μ + 3)) (hp1 : 22 * (μ + 3) ≤ p) (hp2 : p < 24 * (μ + 3)) (hsp : s ≤ p) :
    H (μ + 3) s p < 6 * (μ + 3) - 1 → H (μ + 3) s p = p - s := by
  rw [H_expand3]
  have hrp : p = 22 * (μ + 3) ∨ p = 22 * (μ + 3) + 1 ∨ p = 22 * (μ + 3) + 2 ∨ p = 22 * (μ + 3) + 3 ∨ (22 * (μ + 3) + 4 ≤ p ∧ p + 2 ≤ 24 * (μ + 3)) ∨ p + 1 = 24 * (μ + 3) := by omega
  have hu := ev_z2_l h
  simp only [hu]
  clear hu
  rcases hrp with h' | h' | h' | h' | h' | h'
  · have hw := ev_z11_r0 h'
    simp only [hw, tri_f_0_0, tri_f_1_0, tri_f_1_1, tri_f_2_0, tri_f_2_1, tri_f_2_2, tri_f_3_0, tri_f_3_1, tri_f_3_2, tri_f_3_3]
