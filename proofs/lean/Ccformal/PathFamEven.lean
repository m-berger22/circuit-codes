import Ccformal.PathFamEvenDefs
import Ccformal.PathFamEvenSign

/-!
# The even family fam(k, m) is a spread-k path: `P(d,k) = 3k + 3l - 2` on even lines `l`      (S178)

STATUS: everything in this file and in `PathFamEvenDefs.lean`, `PathFamEvenSign.lean` is PROVED (no `sorry`).

Hand proof: `PROOF_family_even.md` (paths folder); python twin of the definitions (brute-force tested, all hypotheses of
`isPathWord_of_height`): not included; the repetitive parts were generated by scripts (not included): step lemmas in
`PathFamEvenDefs.lean`, and `PathFamEvenSign.lean`.

Parameters: `K = 2κ`, `m = 2h`, `k + 1 = K`, `K ≥ 2m` (`2h ≤ κ`), `d = 3κ + h`, `L = 6κ + 6h + 1 = 3K + 3m + 1`.

* `PathFamEvenDefs.lean`: `famT`, `famT_lt`, `famF` (word into `Fin (3κ+h)`; takes the proofs of `1 ≤ κ`, `2h ≤ κ`),
  the Sign Table predicate `dn`, the height function `H` (by blocks: `HBA`, `HCA`, `HDA`, `HCB`, `HDB`, `HDC`), and the
  step lemmas `stepBA … stepDC` (one per pair (block of the start, block of the step)).
* `PathFamEvenSign.lean`: `fam_hdn` (a step is a down-step iff `dn`), from one occurrence lemma per row.
* this file: glue between blocks, `fam_step`, and
  - `famEven_isPathWord : 1 ≤ κ → 2h ≤ κ → k + 1 = 2κ → IsPathWord k (6κ+6h+1) (famF κ h _ _)`
  - `famEven_path`      : a vertex path `ℕ → Fin (3κ+h) → Bool`
  - `maxPath_even_l`    : `3h + 1 ≤ κ` (k ≥ 3l − 5, l = 2h + 2):  `IsMaxPath (3κ+h) k (6κ+6h+1)`.
-/

open Finset

namespace Coil

set_option linter.deprecated false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSimpArgs false
set_option linter.unreachableTactic false
set_option linter.style.longLine false

/-! ### glue between the blocks -/

lemma HBA_zero {K s : ℕ} (hs : s < K) : HBA K s 0 = K - s := by
  unfold HBA; split_ifs <;> omega

lemma HCA_zero {K m s : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (hs : s < K) :
    HCA K m s 0 = HBA K s K := by
  unfold HCA HBA; split_ifs <;> omega

lemma HDA_zero {K m s : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (hs : s < K) :
    HDA K m s 0 = HCA K m s (K + m) := by
  unfold HDA HCA; split_ifs <;> omega

lemma HCB_zero {K m t : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (ht : t < K) :
    HCB K m t 0 = K - t := by
  unfold HCB EC; split_ifs <;> omega

lemma HDB_zero {K m t : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (ht : t < K) :
    HDB K m t 0 = HCB K m t (K + m) := by
  unfold HDB HCB EC; split_ifs <;> omega

lemma HDC_zero {K m u : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (hu : u < K + m) :
    HDC K m u 0 = K + m - u := by
  unfold HDC; split_ifs <;> omega

/-! ### evaluation of `H` by blocks -/

variable {κ h : ℕ}

lemma H_AA {s p : ℕ} (hs : s < 2 * κ) (hp : p ≤ 2 * κ) : H κ h s p = p - s := by
  unfold H; rw [if_pos hs, if_pos hp]

lemma H_AB (hκ : 1 ≤ κ) {s p : ℕ} (hs : s < 2 * κ) (h1 : 2 * κ ≤ p) (h2 : p ≤ 4 * κ) :
    H κ h s p = HBA (2 * κ) s (p - 2 * κ) := by
  unfold H; rw [if_pos hs]
  by_cases hp : p ≤ 2 * κ
  · obtain rfl : p = 2 * κ := by omega
    rw [if_pos hp, Nat.sub_self, HBA_zero hs]
  · rw [if_neg hp, if_pos h2]

lemma H_AC (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s p : ℕ} (hs : s < 2 * κ) (h1 : 4 * κ ≤ p) (h2 : p ≤ 6 * κ + 2 * h) :
    H κ h s p = HCA (2 * κ) (2 * h) s (p - 4 * κ) := by
  unfold H; rw [if_pos hs, if_neg (by omega)]
  by_cases hp : p ≤ 4 * κ
  · obtain rfl : p = 4 * κ := by omega
    rw [if_pos hp, Nat.sub_self, HCA_zero (by omega) (by omega) (by omega) (by omega) hs]
    congr 1; omega
  · rw [if_neg hp, if_pos h2]

lemma H_AD (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s p : ℕ} (hs : s < 2 * κ) (h1 : 6 * κ + 2 * h ≤ p) :
    H κ h s p = HDA (2 * κ) (2 * h) s (p - (6 * κ + 2 * h)) := by
  unfold H; rw [if_pos hs, if_neg (by omega), if_neg (by omega)]
  by_cases hp : p ≤ 6 * κ + 2 * h
  · obtain rfl : p = 6 * κ + 2 * h := by omega
    rw [if_pos hp, Nat.sub_self, HDA_zero (by omega) (by omega) (by omega) (by omega) hs]
    congr 1; omega
  · rw [if_neg hp]

lemma H_BB {s p : ℕ} (h1 : 2 * κ ≤ s) (hs : s < 4 * κ) (hp : p ≤ 4 * κ) : H κ h s p = p - s := by
  unfold H; rw [if_neg (by omega), if_pos hs, if_pos hp]

lemma H_BC (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s p : ℕ} (h0 : 2 * κ ≤ s) (hs : s < 4 * κ) (h1 : 4 * κ ≤ p)
    (h2 : p ≤ 6 * κ + 2 * h) : H κ h s p = HCB (2 * κ) (2 * h) (s - 2 * κ) (p - 4 * κ) := by
  unfold H; rw [if_neg (by omega), if_pos hs]
  by_cases hp : p ≤ 4 * κ
  · obtain rfl : p = 4 * κ := by omega
    rw [if_pos hp, Nat.sub_self, HCB_zero (by omega) (by omega) (by omega) (by omega) (by omega)]
    omega
  · rw [if_neg hp, if_pos h2]

lemma H_BD (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s p : ℕ} (h0 : 2 * κ ≤ s) (hs : s < 4 * κ) (h1 : 6 * κ + 2 * h ≤ p) :
    H κ h s p = HDB (2 * κ) (2 * h) (s - 2 * κ) (p - (6 * κ + 2 * h)) := by
  unfold H; rw [if_neg (by omega), if_pos hs, if_neg (by omega)]
  by_cases hp : p ≤ 6 * κ + 2 * h
  · obtain rfl : p = 6 * κ + 2 * h := by omega
    rw [if_pos hp, Nat.sub_self, HDB_zero (by omega) (by omega) (by omega) (by omega) (by omega)]
    congr 1; omega
  · rw [if_neg hp]

lemma H_CC {s p : ℕ} (h1 : 4 * κ ≤ s) (hs : s < 6 * κ + 2 * h) (hp : p ≤ 6 * κ + 2 * h) : H κ h s p = p - s := by
  unfold H; rw [if_neg (by omega), if_neg (by omega), if_pos hs, if_pos hp]

lemma H_CD (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s p : ℕ} (h0 : 4 * κ ≤ s) (hs : s < 6 * κ + 2 * h)
    (h1 : 6 * κ + 2 * h ≤ p) : H κ h s p = HDC (2 * κ) (2 * h) (s - 4 * κ) (p - (6 * κ + 2 * h)) := by
  unfold H; rw [if_neg (by omega), if_neg (by omega), if_pos hs]
  by_cases hp : p ≤ 6 * κ + 2 * h
  · obtain rfl : p = 6 * κ + 2 * h := by omega
    rw [if_pos hp, Nat.sub_self, HDC_zero (by omega) (by omega) (by omega) (by omega) (by omega)]
    omega
  · rw [if_neg hp]

lemma H_DD {s p : ℕ} (h1 : 6 * κ + 2 * h ≤ s) : H κ h s p = p - s := by
  unfold H; rw [if_neg (by omega), if_neg (by omega), if_neg (by omega)]

/-! ### the step lemma for `H` -/

theorem fam_step (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) (s j : ℕ) (hsj : s ≤ j) (hj : j < 6 * κ + 6 * h + 1) :
    (¬ dn κ h s j → H κ h s (j + 1) = H κ h s j + 1)
      ∧ (dn κ h s j → 2 * κ ≤ H κ h s j ∧ H κ h s (j + 1) + 1 = H κ h s j) := by
  have hK : (2 * κ) % 2 = 0 := by omega
  have hm : (2 * h) % 2 = 0 := by omega
  have hKm : 2 * (2 * h) ≤ 2 * κ := by omega
  have hK2 : 2 ≤ 2 * κ := by omega
  rcases Nat.lt_or_ge s (2 * κ) with hs1 | hs1
  · -- s in A
    rcases Nat.lt_or_ge j (2 * κ) with hj1 | hj1
    · rw [H_AA hs1 (by omega), H_AA hs1 (by omega)]
      exact ⟨fun _ => by omega, fun hd => absurd hd (dn_A hj1)⟩
    rcases Nat.lt_or_ge j (4 * κ) with hj2 | hj2
    · rw [H_AB hκ hs1 (by omega) (by omega), H_AB hκ hs1 hj1 (by omega), dn_B hj1 hj2,
        show j + 1 - 2 * κ = (j - 2 * κ) + 1 by omega]
      exact stepBA hK hs1 (by omega)
    rcases Nat.lt_or_ge j (6 * κ + 2 * h) with hj3 | hj3
    · rw [H_AC hκ hh hs1 (by omega) (by omega), H_AC hκ hh hs1 hj2 (by omega), dn_C hj2 hj3,
        show j + 1 - 4 * κ = (j - 4 * κ) + 1 by omega]
      exact stepCA hK hm hKm hK2 hs1 (by omega)
    · rw [H_AD hκ hh hs1 (by omega), H_AD hκ hh hs1 hj3, dn_D hj3,
        show j + 1 - (6 * κ + 2 * h) = (j - (6 * κ + 2 * h)) + 1 by omega]
      exact stepDA hK hm hKm hK2 hs1 (by omega)
  rcases Nat.lt_or_ge s (4 * κ) with hs2 | hs2
  · -- s in B
    have es : s = 2 * κ + (s - 2 * κ) := by omega
    rcases Nat.lt_or_ge j (4 * κ) with hj2 | hj2
    · rw [H_BB hs1 hs2 (by omega), H_BB hs1 hs2 (by omega)]
      refine ⟨fun _ => by omega, fun hd => ?_⟩
      exfalso
      rw [dn_B (by omega) hj2] at hd
      unfold dnB at hd
      omega
    rcases Nat.lt_or_ge j (6 * κ + 2 * h) with hj3 | hj3
    · rw [H_BC hκ hh hs1 hs2 (by omega) (by omega), H_BC hκ hh hs1 hs2 hj2 (by omega), dn_C hj2 hj3,
        show j + 1 - 4 * κ = (j - 4 * κ) + 1 by omega]
      have := stepCB (t := s - 2 * κ) (y := j - 4 * κ) hK hm hKm hK2 (by omega) (by omega)
      rw [← es] at this
      exact this
    · rw [H_BD hκ hh hs1 hs2 (by omega), H_BD hκ hh hs1 hs2 hj3, dn_D hj3,
        show j + 1 - (6 * κ + 2 * h) = (j - (6 * κ + 2 * h)) + 1 by omega]
      have := stepDB (t := s - 2 * κ) (z := j - (6 * κ + 2 * h)) hK hm hKm hK2 (by omega) (by omega)
      rw [← es] at this
      exact this
  rcases Nat.lt_or_ge s (6 * κ + 2 * h) with hs3 | hs3
  · -- s in C
    have es : s = 2 * (2 * κ) + (s - 4 * κ) := by omega
    rcases Nat.lt_or_ge j (6 * κ + 2 * h) with hj3 | hj3
    · rw [H_CC hs2 hs3 (by omega), H_CC hs2 hs3 (by omega)]
      refine ⟨fun _ => by omega, fun hd => ?_⟩
      exfalso
      rw [dn_C (by omega) hj3] at hd
      unfold dnC at hd
      split_ifs at hd <;> omega
    · rw [H_CD hκ hh hs2 hs3 (by omega), H_CD hκ hh hs2 hs3 hj3, dn_D hj3,
        show j + 1 - (6 * κ + 2 * h) = (j - (6 * κ + 2 * h)) + 1 by omega]
      have := stepDC (u := s - 4 * κ) (z := j - (6 * κ + 2 * h)) hK hm hKm hK2 (by omega) (by omega)
      rw [← es] at this
      exact this
  · -- s in D
    rw [H_DD hs3, H_DD hs3]
    refine ⟨fun _ => by omega, fun hd => ?_⟩
    exfalso
    rw [dn_D (by omega)] at hd
    unfold dnD at hd
    split_ifs at hd <;> omega

/-! ### the theorems -/

lemma fam_h0 (s : ℕ) : H κ h s s = 0 := by
  unfold H; split_ifs <;> omega

/-- **The even family is a spread-`k` path word** of length `3K + 3m + 1` over `(3K + m)/2` letters. -/
theorem famEven_isPathWord (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {k : ℕ} (hk : k + 1 = 2 * κ) :
    IsPathWord k (6 * κ + 6 * h + 1) (famF κ h hκ hh) :=
  isPathWord_of_height (H κ h) (dn κ h) (fun s w hw => fam_hdn hκ hh s w hw) (fun s _ => fam_h0 s)
    (fun s j hsj hj hd => (fam_step hκ hh s j hsj hj).1 hd)
    (fun s j hsj hj hd => by
      have := (fam_step hκ hh s j hsj hj).2 hd
      exact ⟨by omega, this.2⟩)

theorem famEven_path (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {k : ℕ} (hk : k + 1 = 2 * κ) :
    ∃ v : ℕ → Fin (3 * κ + h) → Bool, IsPath k (6 * κ + 6 * h + 1) v :=
  (famEven_isPathWord hκ hh hk).exists_path

/-- **`P(d,k) = 3k + 3l - 2`** for odd `k`, even `l = 2h + 2`, `2d = 3k + l + 1`, `k ≥ 3l - 5`. -/
theorem maxPath_even_l (hκ : 3 * h + 1 ≤ κ) {k : ℕ} (hk : k + 1 = 2 * κ) :
    IsMaxPath (3 * κ + h) k (6 * κ + 6 * h + 1) := by
  refine ⟨famEven_path (by omega) (by omega) hk, fun L' v' h' => ?_⟩
  have hodd : ¬ Even k := by
    rw [Nat.not_even_iff_odd]
    exact ⟨κ - 1, by omega⟩
  have := path_length_bound h' (by omega) (2 * h + 2) (by simp only [Fintype.card_fin]; omega) (by omega)
    (by rw [if_neg hodd]; omega)
  omega

end Coil

#print axioms Coil.famEven_isPathWord
#print axioms Coil.maxPath_even_l
