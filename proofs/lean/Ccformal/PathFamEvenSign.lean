/-- **Sign Table.** -/
theorem fam_hdn (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) (s w : ℕ) (hw : s + w < 6 * κ + 6 * h + 1) :
    Odd (cnt (famF κ h hκ hh) s w ((famF κ h hκ hh) (s + w))) ↔ dn κ h s (s + w) := by
  have key : ∀ j, s ≤ j → j < 6 * κ + 6 * h + 1 → (Odd (cnt (famF κ h hκ hh) s (j - s) ((famF κ h hκ hh) j)) ↔ dn κ h s j) := by
    intro j hsj hj
    rcases Nat.lt_or_ge j (2 * κ) with h1 | h1
    · exact row_A hκ hh h1 hsj
    rcases Nat.lt_or_ge j (4 * κ) with h2 | h2
    · rcases Nat.mod_two_eq_zero_or_one (j - 2 * κ) with h3 | h3
      · exact row_Be hκ hh (a := (j - 2 * κ) / 2) (by omega) (by omega) hsj
      · exact row_Bo hκ hh (a := (j - 2 * κ) / 2) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (4 * κ + 2 * h) with h3 | h3
    · rcases Nat.mod_two_eq_zero_or_one (j - 4 * κ) with h4 | h4
      · exact row_C1e hκ hh (a := (j - 4 * κ) / 2) (by omega) (by omega) hsj
      · exact row_C1o hκ hh (a := (j - 4 * κ) / 2) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (4 * κ + 6 * h) with h4 | h4
    · have h5 : (j - 4 * κ - 2 * h) % 4 = 0 ∨ (j - 4 * κ - 2 * h) % 4 = 1 ∨ (j - 4 * κ - 2 * h) % 4 = 2
          ∨ (j - 4 * κ - 2 * h) % 4 = 3 := by omega
      rcases h5 with h5 | h5 | h5 | h5
      · exact row_C20 hκ hh (a := (j - 4 * κ - 2 * h) / 4) (by omega) (by omega) hsj
      · exact row_C21 hκ hh (a := (j - 4 * κ - 2 * h) / 4) (by omega) (by omega) hsj
      · exact row_C22 hκ hh (a := (j - 4 * κ - 2 * h) / 4) (by omega) (by omega) hsj
      · exact row_C23 hκ hh (a := (j - 4 * κ - 2 * h) / 4) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (6 * κ + 2 * h) with h5 | h5
    · rcases Nat.mod_two_eq_zero_or_one (j - 4 * κ - 2 * h) with h6 | h6
      · exact row_C3e hκ hh (a := (j - 4 * κ - 2 * h) / 2) (by omega) (by omega) (by omega) hsj
      · exact row_C3o hκ hh (a := (j - 4 * κ - 2 * h) / 2) (by omega) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (6 * κ + 6 * h) with h6 | h6
    · have h7 : (j - 6 * κ - 2 * h) % 4 = 0 ∨ (j - 6 * κ - 2 * h) % 4 = 1 ∨ (j - 6 * κ - 2 * h) % 4 = 2
          ∨ (j - 6 * κ - 2 * h) % 4 = 3 := by omega
      rcases h7 with h7 | h7 | h7 | h7
      · exact row_D0 hκ hh (a := (j - 6 * κ - 2 * h) / 4) (by omega) (by omega) hsj
      · exact row_D1 hκ hh (a := (j - 6 * κ - 2 * h) / 4) (by omega) (by omega) hsj
      · exact row_D2 hκ hh (a := (j - 6 * κ - 2 * h) / 4) (by omega) (by omega) hsj
      · exact row_D3 hκ hh (a := (j - 6 * κ - 2 * h) / 4) (by omega) (by omega) hsj
    rcases Nat.eq_zero_or_pos h with h7 | h7
    · exact row_Dz hκ hh (by omega) h7 hsj
    · exact row_Ds hκ hh (by omega) h7 hsj
  have := key (s + w) (by omega) hw
  rwa [Nat.add_sub_cancel_left] at this

end Coil
