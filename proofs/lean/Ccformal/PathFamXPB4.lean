import Ccformal.PathFamXPB4_4f
import Ccformal.PathFamXPB4_5f
import Ccformal.PathFamXPB4_6f
import Ccformal.PathFamXPB4_7f
import Ccformal.PathFamXPB4_8f
import Ccformal.PathFamXPB4_9f
import Ccformal.PathFamXPB4_10f
import Ccformal.PathFamXPB4_11f
import Ccformal.PathFamXPB4_12f

/-! The path property in closed form for starts in zone 4 (GENERATED by gen2.py) -/

namespace Coil.FamX

set_option linter.unusedVariables false
set_option linter.deprecated false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.style.longLine false
set_option maxHeartbeats 1000000
set_option Elab.async false

lemma pb_s4 {μ s p : ℕ} (hs1 : 8 * (μ + 3) ≤ s) (hs2 : s < 10 * (μ + 3)) (hsp : s ≤ p) (hp : p ≤ 24 * (μ + 3) + 2) :
    H (μ + 3) s p < 6 * (μ + 3) - 1 → H (μ + 3) s p = p - s := by
  rcases Nat.lt_or_ge p (10 * (μ + 3)) with h4 | h4
  · exact pb_4_4 hs1 hs2 (by omega) h4 hsp
  rcases Nat.lt_or_ge p (12 * (μ + 3)) with h5 | h5
  · exact pb_4_5 hs1 hs2 (by omega) h5 hsp
  rcases Nat.lt_or_ge p (14 * (μ + 3)) with h6 | h6
  · exact pb_4_6 hs1 hs2 (by omega) h6 hsp
  rcases Nat.lt_or_ge p (16 * (μ + 3)) with h7 | h7
  · exact pb_4_7 hs1 hs2 (by omega) h7 hsp
  rcases Nat.lt_or_ge p (18 * (μ + 3)) with h8 | h8
  · exact pb_4_8 hs1 hs2 (by omega) h8 hsp
  rcases Nat.lt_or_ge p (20 * (μ + 3)) with h9 | h9
  · exact pb_4_9 hs1 hs2 (by omega) h9 hsp
  rcases Nat.lt_or_ge p (22 * (μ + 3)) with h10 | h10
  · exact pb_4_10 hs1 hs2 (by omega) h10 hsp
  rcases Nat.lt_or_ge p (24 * (μ + 3)) with h11 | h11
  · exact pb_4_11 hs1 hs2 (by omega) h11 hsp
  exact pb_4_12 hs1 hs2 (by omega) hp hsp

end Coil.FamX
