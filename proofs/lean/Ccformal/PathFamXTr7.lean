lemma trans_z7 {μ x : ℕ} (h1 : 14 * (μ + 3) ≤ x) (h2 : x < 16 * (μ + 3)) : Trans (μ + 3) x := by
  have hn : x = 14 * (μ + 3) ∨ x = 14 * (μ + 3) + 1 ∨ x = 14 * (μ + 3) + 2 ∨ x = 14 * (μ + 3) + 3 ∨ (14 * (μ + 3) + 4 ≤ x ∧ x + 3 ≤ 16 * (μ + 3)) ∨ x + 2 = 16 * (μ + 3) ∨ x + 1 = 16 * (μ + 3) := by omega
  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z7_p0 hn
  · exact tr_z7_p1 hn
  · exact tr_z7_p2 hn
  · exact tr_z7_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 14 * (μ + 3)) with hp | hp
    · exact tr_z7_ge (n := (x - 14 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z7_go (n := (x - 14 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z7_gt (by omega)
  · exact tr_z7_l (by omega)

