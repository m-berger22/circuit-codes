  · exact ⟨133, 364, by norm_num [kmaxOf], by norm_num [kmaxOf], (kmax_exact_l1 3 (by norm_num)).1⟩
  · exact ⟨141, 386, by norm_num [kmaxOf], by norm_num [kmaxOf], coil_141_89⟩
  · exact ⟨161, 440, by norm_num [kmaxOf], by norm_num [kmaxOf], coil_161_102⟩
