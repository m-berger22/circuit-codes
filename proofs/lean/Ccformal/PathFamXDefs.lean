/-- the letter at `x` is `(τ, i)`; exactly its counter `κ0` increases; a middle letter arrives in cyclic order -/
def Trans (t x : ℕ) : Prop :=
  ∃ τ i κ0, τ < 10 ∧ 1 ≤ i ∧ i ≤ t ∧ lett t x = (τ, i) ∧ κ0 = 3 * τ + kind t i ∧
    (∀ κ, κ < 30 → ctr t κ (x + 1) = ctr t κ x + if κ = κ0 then 1 else 0) ∧
    (2 ≤ i → i + 1 ≤ t → ∃ q, q ≤ 3 ∧ ctr t κ0 x = (i - 2) + q * (t - 2))

lemma ctr_out {t κ p : ℕ} (h : 30 ≤ κ) : ctr t κ p = 0 := by
  obtain ⟨k, rfl⟩ : ∃ k, κ = k + 30 := ⟨κ - 30, by omega⟩
  rfl

/-- triangle wave of period `2 m`: size of the symmetric difference of two cyclic interval states -/
def tri (m d : ℕ) : ℕ := min d (2 * m - d) + min (d - 2 * m) (4 * m - d)

def g (t κ a b : ℕ) : ℕ := if κ % 3 = 1 then tri (t - 2) (b - a) else (a + b) % 2

/-- the height function: Hamming distance between the vertices `s ≤ p`, from the 30 counters -/
def H (t s p : ℕ) : ℕ := ∑ κ ∈ Finset.range 30, g t κ (ctr t κ s) (ctr t κ p)

lemma H_expand (t s p : ℕ) : H t s p =
    (ctr t 0 s + ctr t 0 p) % 2 +
    tri (t - 2) (ctr t 1 p - ctr t 1 s) +
    (ctr t 2 s + ctr t 2 p) % 2 +
    (ctr t 3 s + ctr t 3 p) % 2 +
    tri (t - 2) (ctr t 4 p - ctr t 4 s) +
    (ctr t 5 s + ctr t 5 p) % 2 +
    (ctr t 6 s + ctr t 6 p) % 2 +
    tri (t - 2) (ctr t 7 p - ctr t 7 s) +
    (ctr t 8 s + ctr t 8 p) % 2 +
    (ctr t 9 s + ctr t 9 p) % 2 +
    tri (t - 2) (ctr t 10 p - ctr t 10 s) +
    (ctr t 11 s + ctr t 11 p) % 2 +
    (ctr t 12 s + ctr t 12 p) % 2 +
    tri (t - 2) (ctr t 13 p - ctr t 13 s) +
    (ctr t 14 s + ctr t 14 p) % 2 +
    (ctr t 15 s + ctr t 15 p) % 2 +
    tri (t - 2) (ctr t 16 p - ctr t 16 s) +
    (ctr t 17 s + ctr t 17 p) % 2 +
    (ctr t 18 s + ctr t 18 p) % 2 +
    tri (t - 2) (ctr t 19 p - ctr t 19 s) +
    (ctr t 20 s + ctr t 20 p) % 2 +
    (ctr t 21 s + ctr t 21 p) % 2 +
    tri (t - 2) (ctr t 22 p - ctr t 22 s) +
    (ctr t 23 s + ctr t 23 p) % 2 +
    (ctr t 24 s + ctr t 24 p) % 2 +
    tri (t - 2) (ctr t 25 p - ctr t 25 s) +
    (ctr t 26 s + ctr t 26 p) % 2 +
    (ctr t 27 s + ctr t 27 p) % 2 +
    tri (t - 2) (ctr t 28 p - ctr t 28 s) +
    (ctr t 29 s + ctr t 29 p) % 2 := by
  simp (config := {decide := true}) only [H, Finset.sum_range_succ, Finset.sum_range_zero, g, zero_add, ite_true, ite_false, Nat.reduceMod]

lemma H_expand3 (μ s p : ℕ) : H (μ + 3) s p =
    (ctr (μ + 3) 0 s + ctr (μ + 3) 0 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 1 p - ctr (μ + 3) 1 s) +
    (ctr (μ + 3) 2 s + ctr (μ + 3) 2 p) % 2 +
    (ctr (μ + 3) 3 s + ctr (μ + 3) 3 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 4 p - ctr (μ + 3) 4 s) +
    (ctr (μ + 3) 5 s + ctr (μ + 3) 5 p) % 2 +
    (ctr (μ + 3) 6 s + ctr (μ + 3) 6 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 7 p - ctr (μ + 3) 7 s) +
    (ctr (μ + 3) 8 s + ctr (μ + 3) 8 p) % 2 +
    (ctr (μ + 3) 9 s + ctr (μ + 3) 9 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 10 p - ctr (μ + 3) 10 s) +
    (ctr (μ + 3) 11 s + ctr (μ + 3) 11 p) % 2 +
    (ctr (μ + 3) 12 s + ctr (μ + 3) 12 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 13 p - ctr (μ + 3) 13 s) +
    (ctr (μ + 3) 14 s + ctr (μ + 3) 14 p) % 2 +
    (ctr (μ + 3) 15 s + ctr (μ + 3) 15 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 16 p - ctr (μ + 3) 16 s) +
    (ctr (μ + 3) 17 s + ctr (μ + 3) 17 p) % 2 +
    (ctr (μ + 3) 18 s + ctr (μ + 3) 18 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 19 p - ctr (μ + 3) 19 s) +
    (ctr (μ + 3) 20 s + ctr (μ + 3) 20 p) % 2 +
    (ctr (μ + 3) 21 s + ctr (μ + 3) 21 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 22 p - ctr (μ + 3) 22 s) +
    (ctr (μ + 3) 23 s + ctr (μ + 3) 23 p) % 2 +
    (ctr (μ + 3) 24 s + ctr (μ + 3) 24 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 25 p - ctr (μ + 3) 25 s) +
    (ctr (μ + 3) 26 s + ctr (μ + 3) 26 p) % 2 +
    (ctr (μ + 3) 27 s + ctr (μ + 3) 27 p) % 2 +
    tri (μ + 1) (ctr (μ + 3) 28 p - ctr (μ + 3) 28 s) +
    (ctr (μ + 3) 29 s + ctr (μ + 3) 29 p) % 2 := by
  rw [H_expand]; rfl

/-! `tri` on canonical arguments `q m + v`, `0 ≤ v ≤ m` -/
lemma tri_f_0_0 (m vp vs : ℕ) :
    tri m (0 * m + min vp m - (0 * m + min vs m)) = min vp m - min vs m := by
  have h1 := Nat.min_le_right vp m
  have h2 := Nat.min_le_right vs m
  generalize min vp m = x at *
  generalize min vs m = y at *
  unfold tri; rcases Nat.le_total x y with h | h <;> omega
lemma tri_f_1_0 (m vp vs : ℕ) :
    tri m (1 * m + min vp m - (0 * m + min vs m)) = m - ((min vp m - min vs m) + (min vs m - min vp m)) := by
  have h1 := Nat.min_le_right vp m
  have h2 := Nat.min_le_right vs m
  generalize min vp m = x at *
