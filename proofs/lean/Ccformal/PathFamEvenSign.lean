import Ccformal.PathFamEvenDefs

/-!
# The even family: the Sign Table      (generated by a script, not included)

`fam_hdn`: step `j = s + w` is a down-step for `s` (the letter at `j` occurs an odd number of times in `[s, j)`) iff
`dn κ h s j`.  One lemma `row_*` per row of the Sign Table of PROOF_family.md.
-/

open Finset

namespace Coil

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSimpArgs false
set_option linter.unreachableTactic false
set_option linter.style.longLine false

variable {κ h : ℕ}

lemma hdn_of0 (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j v : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v)
    (hocc : ∀ i, i < j → famT κ h i ≠ v) (hD : ¬ dn κ h s j) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  refine hdn_of hκ hh hsj hv (p1 := j + 1) (p2 := j + 2) (p3 := j + 3)
    (fun i hi => ⟨fun e => absurd e (hocc i hi), fun e => by omega⟩) (by omega) (by omega) (by omega) ?_
  constructor
  · intro hd; exact absurd hd hD
  · intro hp; exfalso; omega

lemma hdn_of1 (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j v p1 : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v) (hp1 : p1 < j)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1)) (hD : dn κ h s j ↔ s ≤ p1) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  refine hdn_of hκ hh hsj hv (p1 := p1) (p2 := j + 2) (p3 := j + 3)
    (fun i hi => by rw [hocc i hi]; omega) (by omega) (by omega) (by omega) ?_
  rw [hD]; omega

lemma hdn_of2 (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j v p1 p2 : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v) (hp1 : p1 < j)
    (hp2 : p2 < p1)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1 ∨ i = p2)) (hD : dn κ h s j ↔ (p2 < s ∧ s ≤ p1)) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  refine hdn_of hκ hh hsj hv (p1 := p1) (p2 := p2) (p3 := j + 3)
    (fun i hi => by rw [hocc i hi]; omega) (by omega) (by omega) (by omega) ?_
  rw [hD]; omega

lemma hdn_of3 (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j v p1 p2 p3 : ℕ} (hsj : s ≤ j) (hv : famT κ h j = v) (hp1 : p1 < j)
    (hp2 : p2 < p1) (hp3 : p3 < p2)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1 ∨ i = p2 ∨ i = p3))
    (hD : dn κ h s j ↔ ((p2 < s ∧ s ≤ p1) ∨ s ≤ p3)) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  refine hdn_of hκ hh hsj hv (p1 := p1) (p2 := p2) (p3 := p3) hocc (by omega) (by omega) (by omega) ?_
  rw [hD]; omega

lemma row_A (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j : ℕ} (ha : j < 2 * κ) (hsj : s ≤ j) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  refine hdn_of0 hκ hh hsj (v := j)  ?_  ?_ ?_
  · unfold famT; split_ifs <;> omega
  · intro i hi; unfold famT; split_ifs <;> omega
  · exact dn_A ha

lemma row_Be (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j a : ℕ} (hj : j = 2 * κ + 2 * a) (ha : a < κ) (hsj : s ≤ j) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  subst hj
  refine hdn_of1 hκ hh hsj (v := 2 * a) (p1 := 2 * a) ?_ (by omega) ?_ ?_
  · unfold famT; split_ifs <;> omega
  · intro i hi; unfold famT; split_ifs <;> omega
  · rw [dn_B (by omega) (by omega)]; unfold dnB; omega

lemma row_Bo (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j a : ℕ} (hj : j = 2 * κ + 2 * a + 1) (ha : a < κ) (hsj : s ≤ j) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  subst hj
  refine hdn_of0 hκ hh hsj (v := 2 * κ + a)  ?_  ?_ ?_
  · unfold famT; split_ifs <;> omega
  · intro i hi; unfold famT; split_ifs <;> omega
  · rw [dn_B (by omega) (by omega)]; unfold dnB; omega

lemma row_C1e (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j a : ℕ} (hj : j = 4 * κ + 2 * a) (ha : a < h) (hsj : s ≤ j) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  subst hj
  refine hdn_of2 hκ hh hsj (v := 2 * a) (p1 := 2 * κ + 2 * a) (p2 := 2 * a) ?_ (by omega) (by omega) ?_ ?_
  · unfold famT; split_ifs <;> omega
  · intro i hi; unfold famT; split_ifs <;> omega
  · rw [dn_C (by omega) (by omega)]; unfold dnC
    split_ifs <;> first | omega | (simp only [false_iff, true_iff, not_false_eq_true, not_true_eq_false] <;> omega) | contradiction

