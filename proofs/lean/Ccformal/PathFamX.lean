/-!
# The first-excess family is a spread-`(6t-1)` path of length `24t+2` in the `10t`-cube, for all `t ≥ 3`   (S179)

`famXF t ht : ℕ → Fin (10 * t)` is the word `fam(t)` of `pfam2.py` (letters `(τ, i) ↦ τ * t + (i - 1)`).

* `famX_isPathWord : 3 ≤ t → IsPathWord (6 * t - 1) (24 * t + 2) (famXF t ht)`
* `famX_path`: the vertex version, `∃ v : ℕ → Fin (10 * t) → Bool, IsPath (6 * t - 1) (24 * t + 2) v`
* `maxPath_excess_ge`: `IsMaxPath (10 * t) (6 * t - 1) L → 24 * t + 2 ≤ L`  (lower bound `P(10t, 6t-1) ≥ 24t+2`,
  one more than the line value `3k + 3l - 2 = 24t + 1` at `l = 2t + 2`, `k = 3l - 7`).

Proof (no occurrence lemmas, no case table of windows in this file):
1. `Trans t x` (files `PathFamXTr*`): at every position exactly one of 30 counters `ctr t κ` (type × {index 1, middle
   index, index t}) increases, and a middle letter `τ_i` arrives when its counter is `≡ i - 2 (mod t - 2)`.
2. Hence the set of coordinates of vertex `v_p` is read off the counters (`ins`), `Odd (cnt …) ↔ membership differs`
   (`cnt_parity`), the closed form `H` (sum of 20 parities and 10 triangle waves) changes by `±1` in step with `oddc`
   (`H_step`), so `oddc T s w = H t s (s + w)` (`oddc_eq_H`).
3. `pb` (files `PathFamXPB*`, `omega` on pairs of regions): `H t s p < 6t - 1 → H t s p = p - s`.

Generated by scripts (not included), after a python twin of the definitions was brute-force tested.
-/

open Finset

namespace Coil
namespace FamX

set_option linter.unusedVariables false
set_option linter.deprecated false

/-- `Trans` at every position of the word -/
lemma trans_all {t x : ℕ} (ht : 3 ≤ t) (hx : x < 24 * t + 2) : Trans t x := by
  obtain ⟨μ, rfl⟩ : ∃ μ, t = μ + 3 := ⟨t - 3, by omega⟩
  rcases Nat.lt_or_ge x (2 * (μ + 3)) with h0 | h0
  · exact trans_z0 (by omega) h0
  rcases Nat.lt_or_ge x (4 * (μ + 3)) with h1 | h1
  · exact trans_z1 (by omega) h1
  rcases Nat.lt_or_ge x (6 * (μ + 3)) with h2 | h2
  · exact trans_z2 (by omega) h2
  rcases Nat.lt_or_ge x (8 * (μ + 3)) with h3 | h3
  · exact trans_z3 (by omega) h3
  rcases Nat.lt_or_ge x (10 * (μ + 3)) with h4 | h4
  · exact trans_z4 (by omega) h4
  rcases Nat.lt_or_ge x (12 * (μ + 3)) with h5 | h5
  · exact trans_z5 (by omega) h5
  rcases Nat.lt_or_ge x (14 * (μ + 3)) with h6 | h6
  · exact trans_z6 (by omega) h6
  rcases Nat.lt_or_ge x (16 * (μ + 3)) with h7 | h7
  · exact trans_z7 (by omega) h7
  rcases Nat.lt_or_ge x (18 * (μ + 3)) with h8 | h8
  · exact trans_z8 (by omega) h8
  rcases Nat.lt_or_ge x (20 * (μ + 3)) with h9 | h9
  · exact trans_z9 (by omega) h9
  rcases Nat.lt_or_ge x (22 * (μ + 3)) with h10 | h10
  · exact trans_z10 (by omega) h10
  rcases Nat.lt_or_ge x (24 * (μ + 3)) with h11 | h11
  · exact trans_z11 (by omega) h11
  rcases Nat.lt_or_ge x (24 * (μ + 3) + 1) with h | h
  · exact trans_tail0 (by omega)
  · exact trans_tail1 (by omega)

/-- the closed-form path property -/
lemma pb {t s p : ℕ} (ht : 3 ≤ t) (hsp : s ≤ p) (hp : p ≤ 24 * t + 2) :
    H t s p < 6 * t - 1 → H t s p = p - s := by
  obtain ⟨μ, rfl⟩ : ∃ μ, t = μ + 3 := ⟨t - 3, by omega⟩
  rcases Nat.lt_or_ge s (2 * (μ + 3)) with h0 | h0
  · exact pb_s0 (by omega) h0 hsp hp
  rcases Nat.lt_or_ge s (4 * (μ + 3)) with h1 | h1
  · exact pb_s1 (by omega) h1 hsp hp
  rcases Nat.lt_or_ge s (6 * (μ + 3)) with h2 | h2
  · exact pb_s2 (by omega) h2 hsp hp
  rcases Nat.lt_or_ge s (8 * (μ + 3)) with h3 | h3
  · exact pb_s3 (by omega) h3 hsp hp
  rcases Nat.lt_or_ge s (10 * (μ + 3)) with h4 | h4
  · exact pb_s4 (by omega) h4 hsp hp
  rcases Nat.lt_or_ge s (12 * (μ + 3)) with h5 | h5
  · exact pb_s5 (by omega) h5 hsp hp
  rcases Nat.lt_or_ge s (14 * (μ + 3)) with h6 | h6
  · exact pb_s6 (by omega) h6 hsp hp
  rcases Nat.lt_or_ge s (16 * (μ + 3)) with h7 | h7
  · exact pb_s7 (by omega) h7 hsp hp
  rcases Nat.lt_or_ge s (18 * (μ + 3)) with h8 | h8
  · exact pb_s8 (by omega) h8 hsp hp
  rcases Nat.lt_or_ge s (20 * (μ + 3)) with h9 | h9
  · exact pb_s9 (by omega) h9 hsp hp
  rcases Nat.lt_or_ge s (22 * (μ + 3)) with h10 | h10
  · exact pb_s10 (by omega) h10 hsp hp
  rcases Nat.lt_or_ge s (24 * (μ + 3)) with h11 | h11
  · exact pb_s11 (by omega) h11 hsp hp
  exact pb_12_12 h11 (by omega) (by omega) hp hsp

/-! ### the word -/

/-- letter number at position `x` -/
def famXT (t x : ℕ) : ℕ := (lett t x).1 * t + ((lett t x).2 - 1)

lemma famXT_lt {t : ℕ} (ht : 3 ≤ t) (x : ℕ) : famXT t x < 10 * t := by
  unfold famXT
  rcases Nat.lt_or_ge x (24 * t + 2) with h | h
  · obtain ⟨τ, i, κ0, h1, h2, h3, h4, -⟩ := trans_all ht h
    rw [h4]
    have := Nat.mul_le_mul_right t (show τ ≤ 9 by omega)
    show τ * t + (i - 1) < 10 * t
    omega
  · rw [lett_out h]
    show 0 * t + (1 - 1) < 10 * t
    omega

/-- the word `fam(t)` over `Fin (10 t)` -/
def famXF (t : ℕ) (ht : 3 ≤ t) : ℕ → Fin (10 * t) := fun x => ⟨famXT t x, famXT_lt ht x⟩

lemma code_inj {t τ0 i0 τ i : ℕ} (h1 : 1 ≤ i0) (h2 : i0 ≤ t) (h3 : 1 ≤ i) (h4 : i ≤ t) :
    τ0 * t + (i0 - 1) = τ * t + (i - 1) ↔ (τ = τ0 ∧ i = i0) := by
  constructor
  · intro h
    rcases Nat.lt_trichotomy τ0 τ with hl | hl | hl
    · have := Nat.mul_le_mul_right t (show τ0 + 1 ≤ τ from hl)
      rw [Nat.add_mul, one_mul] at this
      omega
    · subst hl
      omega
    · have := Nat.mul_le_mul_right t (show τ + 1 ≤ τ0 from hl)
      rw [Nat.add_mul, one_mul] at this
      omega
  · rintro ⟨rfl, rfl⟩
    rfl

/-! ### membership of a coordinate in a vertex, from the counters -/

/-- cyclic interval state: with counter `u ≤ 4 m`, is the middle index `r + 2` (`r < m`) in the set? -/
def mb (m u r : ℕ) : Prop := (r < u ∧ u ≤ r + m) ∨ (r + 2 * m < u ∧ u ≤ r + 3 * m)

/-- coordinate `(τ, i)` is in vertex `v_p` (= occurs an odd number of times among the first `p` letters) -/
def ins (t τ i p : ℕ) : Prop :=
  if i = 1 then ctr t (3 * τ) p % 2 = 1 else if i = t then ctr t (3 * τ + 2) p % 2 = 1
  else mb (t - 2) (ctr t (3 * τ + 1) p) (i - 2)

lemma kind_cases (t i : ℕ) (ht : 3 ≤ t) :
    (i = 1 ∧ kind t i = 0) ∨ (i = t ∧ kind t i = 2) ∨ (i ≠ 1 ∧ i ≠ t ∧ kind t i = 1) := by
  unfold kind; split_ifs <;> omega

lemma iff_not_iff_of_not {A P : Prop} (hP : ¬ P) : A ↔ ¬ (A ↔ P) := by
  by_cases hA : A <;> simp [hA, hP]

lemma xor_step_pos {A B P : Prop} (hP : P) : (¬ ¬ (A ↔ B)) ↔ ¬ ((¬ (A ↔ P)) ↔ B) := by
  by_cases hA : A <;> by_cases hB : B <;> simp [hA, hB, hP]

lemma xor_step_neg {A B P : Prop} (hP : ¬ P) : (¬ (A ↔ B)) ↔ ¬ ((¬ (A ↔ P)) ↔ B) := by
  by_cases hA : A <;> by_cases hB : B <;> simp [hA, hB, hP]

/-- one more letter of the type: the middle index `r0 + 2` toggles, all others stay -/
lemma mb_toggle {m r0 r u q : ℕ} (hr0 : r0 < m) (hr : r < m) (hq : q ≤ 3) (hu : u = r0 + q * m) :
    mb m (u + 1) r ↔ ¬ (mb m u r ↔ r = r0) := by
  subst hu
  unfold mb
  by_cases hrr : r = r0
  · subst hrr
    interval_cases q <;> omega
  · interval_cases q <;> omega

lemma tri_vals {m e : ℕ} (he : e ≤ 4 * m) :
    (e ≤ m → tri m e = e) ∧ (m ≤ e → e ≤ 2 * m → tri m e = 2 * m - e) ∧
    (2 * m ≤ e → e ≤ 3 * m → tri m e = e - 2 * m) ∧ (3 * m ≤ e → tri m e = 4 * m - e) := by
  unfold tri
  refine ⟨fun h => ?_, fun h h' => ?_, fun h h' => ?_, fun h => ?_⟩ <;> omega

/-- the triangle wave moves by one, up or down according to membership of the toggled index -/
lemma tri_toggle {m r0 a d q : ℕ} (hr0 : r0 < m) (hq : q ≤ 3) (hb : a + d = r0 + q * m) :
    ((mb m (a + d) r0 ↔ mb m a r0) → tri m (d + 1) = tri m d + 1) ∧
    (¬ (mb m (a + d) r0 ↔ mb m a r0) → tri m (d + 1) + 1 = tri m d) := by
  have hd4 : d + 1 ≤ 4 * m := by interval_cases q <;> omega
  have T0 := tri_vals (m := m) (e := d) (by omega)
  have T1 := tri_vals (m := m) (e := d + 1) hd4
  rw [hb]
  unfold mb
  rcases Nat.lt_or_ge d m with h1 | h1
  · have t0 := T0.1 (by omega)
    have t1 := T1.1 (by omega)
    clear T0 T1
    interval_cases q <;> omega
  rcases Nat.lt_or_ge d (2 * m) with h2 | h2
  · have t0 := T0.2.1 h1 (by omega)
    have t1 := T1.2.1 (by omega) (by omega)
    clear T0 T1
    interval_cases q <;> omega
  rcases Nat.lt_or_ge d (3 * m) with h3 | h3
  · have t0 := T0.2.2.1 h2 (by omega)
    have t1 := T1.2.2.1 (by omega) (by omega)
    clear T0 T1
    interval_cases q <;> omega
  · have t0 := T0.2.2.2 h3
    have t1 := T1.2.2.2 (by omega)
    clear T0 T1
    interval_cases q <;> omega

lemma ins_step {t x τ0 i0 κ0 : ℕ} (ht : 3 ≤ t) (hi0 : 1 ≤ i0) (hi0t : i0 ≤ t)
    (hκ0 : κ0 = 3 * τ0 + kind t i0)
    (hc : ∀ κ, κ < 30 → ctr t κ (x + 1) = ctr t κ x + if κ = κ0 then 1 else 0)
    (hq : 2 ≤ i0 → i0 + 1 ≤ t → ∃ q, q ≤ 3 ∧ ctr t κ0 x = (i0 - 2) + q * (t - 2))
    {τ i : ℕ} (hτ : τ < 10) (hi : 1 ≤ i) (hit : i ≤ t) :
    ins t τ i (x + 1) ↔ ¬ (ins t τ i x ↔ (τ = τ0 ∧ i = i0)) := by
  have hkv := kind_cases t i0 ht
  subst hκ0
  unfold ins
  by_cases h1 : i = 1
  · rw [if_pos h1, if_pos h1]
    have h := hc (3 * τ) (by omega)
    clear hq hc
    split_ifs at h with he <;> omega
  rw [if_neg h1, if_neg h1]
  by_cases h2 : i = t
  · rw [if_pos h2, if_pos h2]
    have h := hc (3 * τ + 2) (by omega)
    clear hq hc
    split_ifs at h with he <;> omega
  rw [if_neg h2, if_neg h2]
  have h := hc (3 * τ + 1) (by omega)
  by_cases he : 3 * τ + 1 = 3 * τ0 + kind t i0
  · rw [if_pos he] at h
    obtain ⟨q, hq1, hq2⟩ := hq (by omega) (by omega)
    rw [← he] at hq2
    clear hq hc
    have key := mb_toggle (m := t - 2) (r0 := i0 - 2) (r := i - 2) (by omega) (by omega) hq1 hq2
    have hiff : (i - 2 = i0 - 2) ↔ (τ = τ0 ∧ i = i0) := by omega
    rw [h, key, hiff]
  · rw [if_neg he, add_zero] at h
    clear hq hc
    have hne : ¬ (τ = τ0 ∧ i = i0) := by omega
    rw [h]
    exact iff_not_iff_of_not hne

lemma cnt_parity {t : ℕ} (ht : 3 ≤ t) (s : ℕ) (c : Fin (10 * t)) {τ i : ℕ} (hτ : τ < 10) (hi : 1 ≤ i) (hit : i ≤ t)
    (hc : c.val = τ * t + (i - 1)) (w : ℕ) (hw : s + w ≤ 24 * t + 2) :
    Odd (cnt (famXF t ht) s w c) ↔ ¬ (ins t τ i (s + w) ↔ ins t τ i s) := by
  induction w with
  | zero => simp [cnt]
  | succ w ih =>
    have ih' := ih (by omega)
    obtain ⟨τ0, i0, κ0, h1, h2, h3, h4, h5, h6, h7⟩ := trans_all ht (show s + w < 24 * t + 2 by omega)
    have hst := ins_step ht h2 h3 h5 h6 h7 hτ hi hit
    have hT : famXF t ht (s + w) = c ↔ (τ = τ0 ∧ i = i0) := by
      rw [Fin.ext_iff, hc]
      show famXT t (s + w) = _ ↔ _
      unfold famXT
      rw [h4]
      exact code_inj h2 h3 hi hit
    rw [cnt_add, cnt_one, ← add_assoc, hst]
    by_cases hTc : famXF t ht (s + w) = c
    · rw [if_pos hTc, Nat.odd_add_one, ih']
      exact xor_step_pos (hT.mp hTc)
    · rw [if_neg hTc, add_zero, ih']
      exact xor_step_neg (fun h => hTc (hT.mpr h))

lemma ctr_mono {t : ℕ} (ht : 3 ≤ t) {κ : ℕ} (hκ : κ < 30) {s x : ℕ} (hsx : s ≤ x) (hx : x ≤ 24 * t + 2) :
    ctr t κ s ≤ ctr t κ x := by
  induction x, hsx using Nat.le_induction with
  | base => exact le_rfl
  | succ x hsx ih =>
    obtain ⟨_, _, κ0, -, -, -, -, -, h6, -⟩ := trans_all ht (show x < 24 * t + 2 by omega)
    rw [h6 κ hκ]
    exact le_trans (ih (by omega)) (Nat.le_add_right _ _)

/-- the closed form `H` moves like the Hamming distance -/
lemma H_step {t : ℕ} (ht : 3 ≤ t) {s x : ℕ} (hsx : s ≤ x) (hx : x < 24 * t + 2) :
    ∃ τ i, lett t x = (τ, i) ∧ τ < 10 ∧ 1 ≤ i ∧ i ≤ t ∧
      ((ins t τ i x ↔ ins t τ i s) → H t s (x + 1) = H t s x + 1) ∧
      (¬ (ins t τ i x ↔ ins t τ i s) → H t s (x + 1) + 1 = H t s x) := by
  obtain ⟨τ0, i0, κ0, h1, h2, h3, h4, h5, h6, h7⟩ := trans_all ht hx
  refine ⟨τ0, i0, h4, h1, h2, h3, ?_⟩
  have hkv := kind_cases t i0 ht
  have hκ0lt : κ0 < 30 := by omega
  have hsplit : ∀ p, H t s p = g t κ0 (ctr t κ0 s) (ctr t κ0 p)
      + ∑ κ ∈ (range 30).erase κ0, g t κ (ctr t κ s) (ctr t κ p) :=
    fun p => (add_sum_erase _ _ (mem_range.mpr hκ0lt)).symm
  have hrest : ∑ κ ∈ (range 30).erase κ0, g t κ (ctr t κ s) (ctr t κ (x + 1))
      = ∑ κ ∈ (range 30).erase κ0, g t κ (ctr t κ s) (ctr t κ x) := by
    apply sum_congr rfl
    intro κ hκ
    rw [h6 κ (mem_range.mp (mem_of_mem_erase hκ)), if_neg (ne_of_mem_erase hκ), add_zero]
  have hm := ctr_mono ht hκ0lt hsx (le_of_lt hx)
  rw [hsplit (x + 1), hsplit x, hrest, h6 κ0 hκ0lt, if_pos rfl]
  generalize (∑ κ ∈ (range 30).erase κ0, g t κ (ctr t κ s) (ctr t κ x)) = R
  clear hsplit hrest h6
  unfold ins g
  by_cases e1 : i0 = 1
  · have hk : κ0 = 3 * τ0 := by omega
    subst hk
    clear h7
    rw [if_pos e1, if_pos e1, if_neg (by omega), if_neg (by omega)]
    omega
  by_cases e2 : i0 = t
  · have hk : κ0 = 3 * τ0 + 2 := by omega
    subst hk
    clear h7
    rw [if_neg e1, if_neg e1, if_pos e2, if_pos e2, if_neg (by omega), if_neg (by omega)]
    omega
  have hk : κ0 = 3 * τ0 + 1 := by omega
  subst hk
  rw [if_neg e1, if_neg e1, if_neg e2, if_neg e2, if_pos (by omega), if_pos (by omega)]
  obtain ⟨q, hq1, hq2⟩ := h7 (by omega) (by omega)
  clear h7
  obtain ⟨d, hd⟩ : ∃ d, ctr t (3 * τ0 + 1) x = ctr t (3 * τ0 + 1) s + d :=
    ⟨ctr t (3 * τ0 + 1) x - ctr t (3 * τ0 + 1) s, by omega⟩
  obtain ⟨k1, k2⟩ := tri_toggle (m := t - 2) (r0 := i0 - 2) (a := ctr t (3 * τ0 + 1) s) (d := d) (q := q)
    (by omega) hq1 (by rw [← hd, hq2])
  have e3 : ctr t (3 * τ0 + 1) x + 1 - ctr t (3 * τ0 + 1) s = d + 1 := by omega
  have e4 : ctr t (3 * τ0 + 1) x - ctr t (3 * τ0 + 1) s = d := by omega
  rw [e3, e4, hd]
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have := k1 h
    omega
  · have := k2 h
    omega

lemma H_self (t s : ℕ) : H t s s = 0 := by
  unfold H
  apply sum_eq_zero
  intro κ _
  unfold g tri
  split_ifs <;> omega

/-- the Hamming distance between two vertices of the path, in closed form -/
lemma oddc_eq_H {t : ℕ} (ht : 3 ≤ t) (s w : ℕ) (hw : s + w ≤ 24 * t + 2) :
    oddc (famXF t ht) s w = H t s (s + w) := by
  induction w with
  | zero =>
    rw [add_zero, H_self]
    simp [oddc, cnt]
  | succ w ih =>
    have ih' := ih (by omega)
    obtain ⟨τ, i, hl, hτ, hi1, hit, hup, hdn⟩ :=
      H_step ht (show s ≤ s + w by omega) (show s + w < 24 * t + 2 by omega)
    have hc : (famXF t ht (s + w)).val = τ * t + (i - 1) := by
      show famXT t (s + w) = _
      unfold famXT
      rw [hl]
    have hp := cnt_parity ht s (famXF t ht (s + w)) hτ hi1 hit hc w (by omega)
    rw [← add_assoc]
    by_cases hd : Odd (cnt (famXF t ht) s w (famXF t ht (s + w)))
    · have h2 := oddc_snoc_down hd
      have h3 := hdn (hp.mp hd)
      omega
    · have h2 := oddc_snoc_up hd
      have h3 := hup (by by_contra h; exact hd (hp.mpr h))
      omega

end FamX

/-! ### the theorems -/

/-- the first-excess word `fam(t)` of `pfam2.py`, over `Fin (10 t)` -/
abbrev famX (t : ℕ) (ht : 3 ≤ t) : ℕ → Fin (10 * t) := FamX.famXF t ht

/-- **The first-excess family is a spread-`(6t-1)` path word of length `24t + 2`** over `10t` letters, `t ≥ 3`. -/
theorem famX_isPathWord {t : ℕ} (ht : 3 ≤ t) : IsPathWord (6 * t - 1) (24 * t + 2) (famX t ht) := by
  refine ⟨fun s w hs hw => ?_⟩
  rw [FamX.oddc_eq_H ht s w hs] at hw ⊢
  have := FamX.pb ht (show s ≤ s + w by omega) hs hw
  omega

theorem famX_path {t : ℕ} (ht : 3 ≤ t) : ∃ v : ℕ → Fin (10 * t) → Bool, IsPath (6 * t - 1) (24 * t + 2) v :=
  (famX_isPathWord ht).exists_path

/-- **`P(10t, 6t-1) ≥ 24t + 2`** for `t ≥ 3` (lower-bound half; `24t + 2 = 3k + 3l - 1` with `k = 6t - 1`,
`l = 2d - 3k - 1 = 2t + 2`, i.e. one more than the line value `3k + 3l - 2`). -/
theorem maxPath_excess_ge {t : ℕ} (ht : 3 ≤ t) {L : ℕ} (h : IsMaxPath (10 * t) (6 * t - 1) L) : 24 * t + 2 ≤ L := by
  obtain ⟨v, hv⟩ := famX_path ht
  exact h.2 _ v hv

end Coil

