lemma trans_z0 {μ x : ℕ} (h1 : 0 * (μ + 3) ≤ x) (h2 : x < 2 * (μ + 3)) : Trans (μ + 3) x := by
  have hn : x = 0 * (μ + 3) ∨ x = 0 * (μ + 3) + 1 ∨ x = 0 * (μ + 3) + 2 ∨ x = 0 * (μ + 3) + 3 ∨ (0 * (μ + 3) + 4 ≤ x ∧ x + 3 ≤ 2 * (μ + 3)) ∨ x + 2 = 2 * (μ + 3) ∨ x + 1 = 2 * (μ + 3) := by omega
  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z0_p0 hn
  · exact tr_z0_p1 hn
  · exact tr_z0_p2 hn
  · exact tr_z0_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 0 * (μ + 3)) with hp | hp
    · exact tr_z0_ge (n := (x - 0 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z0_go (n := (x - 0 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z0_gt (by omega)
  · exact tr_z0_l (by omega)

