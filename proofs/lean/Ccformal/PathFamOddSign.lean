/-- **Sign Table.** -/
theorem fam_hdn (hh : 2 * h ≤ κ) (s w : ℕ) (hw : s + w < 6 * κ + 6 * h + 7) :
    Odd (cnt (famF κ h hh) s w ((famF κ h hh) (s + w))) ↔ dn κ h s (s + w) := by
  have key : ∀ j, s ≤ j → j < 6 * κ + 6 * h + 7 → (Odd (cnt (famF κ h hh) s (j - s) ((famF κ h hh) j)) ↔ dn κ h s j) := by
    intro j hsj hj
    rcases Nat.lt_or_ge j (2 * κ + 2) with h1 | h1
    · rcases Nat.eq_zero_or_pos j with h0 | h0
      · exact row_Z0 hh h0 hsj
      · exact row_A hh (a := j - 1) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (4 * κ + 4) with h2 | h2
    · rcases Nat.lt_or_ge j (2 * κ + 3) with h3 | h3
      · exact row_Zp hh (by omega) hsj
      rcases Nat.mod_two_eq_zero_or_one (j - (2 * κ + 3)) with h4 | h4
      · exact row_Be hh (a := (j - (2 * κ + 3)) / 2) (by omega) (by omega) hsj
      · exact row_Bo hh (a := (j - (2 * κ + 3)) / 2) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (4 * κ + 2 * h + 5) with h3 | h3
    · rcases Nat.mod_two_eq_zero_or_one (j - (4 * κ + 4)) with h4 | h4
      · exact row_C1e hh (a := (j - (4 * κ + 4)) / 2) (by omega) (by omega) hsj
      · exact row_C1o hh (a := (j - (4 * κ + 4)) / 2) (by omega) (by omega) hsj
    rcases Nat.lt_or_ge j (4 * κ + 6 * h + 5) with h4 | h4
    · have h5 : (j - (4 * κ + 2 * h + 5)) % 4 = 0 ∨ (j - (4 * κ + 2 * h + 5)) % 4 = 1
          ∨ (j - (4 * κ + 2 * h + 5)) % 4 = 2 ∨ (j - (4 * κ + 2 * h + 5)) % 4 = 3 := by omega
      rcases h5 with h5 | h5 | h5 | h5
