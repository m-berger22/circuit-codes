lemma trans_z6 {μ x : ℕ} (h1 : 12 * (μ + 3) ≤ x) (h2 : x < 14 * (μ + 3)) : Trans (μ + 3) x := by
  have hn : x = 12 * (μ + 3) ∨ x = 12 * (μ + 3) + 1 ∨ x = 12 * (μ + 3) + 2 ∨ x = 12 * (μ + 3) + 3 ∨ (12 * (μ + 3) + 4 ≤ x ∧ x + 3 ≤ 14 * (μ + 3)) ∨ x + 2 = 14 * (μ + 3) ∨ x + 1 = 14 * (μ + 3) := by omega
  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z6_p0 hn
  · exact tr_z6_p1 hn
  · exact tr_z6_p2 hn
  · exact tr_z6_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 12 * (μ + 3)) with hp | hp
    · exact tr_z6_ge (n := (x - 12 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z6_go (n := (x - 12 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z6_gt (by omega)
  · exact tr_z6_l (by omega)

