lemma tr_z0_p0 {μ x : ℕ} (hx : x = 0 * (μ + 3)) : Trans (μ + 3) x := by
  refine ⟨5, 1, 15, by omega, by omega, by omega, ?_, ?_, ?_, ?_⟩
  · rw [lett_z0 (by omega) (by omega), zl0_even 0 (by omega)]; unfold sl000
    first | rfl | (split_ifs <;> first | (exfalso; omega) | (refine Prod.ext ?_ ?_ <;> dsimp only <;> omega)) | (refine Prod.ext ?_ ?_ <;> dsimp only <;> omega)
  · unfold kind; split_ifs <;> omega
  · intro κ hκ
    have hh := ev_z0_r0 (μ := μ) (p := x) (by omega)
    have hk := ev_z0_r1 (μ := μ) (p := x + 1) (by omega)
    rcases eq_or_ne κ 15 with rfl | hne
    · rw [if_pos rfl]; simp only [hk, hh] <;> (clear hk hh; omega)
    · rw [if_neg hne]
      interval_cases κ <;> first | exact absurd rfl hne | (simp only [hk, hh] <;> (clear hk hh; omega))
  · intro h1 h2; exfalso; omega

