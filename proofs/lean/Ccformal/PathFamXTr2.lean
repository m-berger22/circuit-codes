lemma trans_z2 {μ x : ℕ} (h1 : 4 * (μ + 3) ≤ x) (h2 : x < 6 * (μ + 3)) : Trans (μ + 3) x := by
  have hn : x = 4 * (μ + 3) ∨ x = 4 * (μ + 3) + 1 ∨ x = 4 * (μ + 3) + 2 ∨ x = 4 * (μ + 3) + 3 ∨ (4 * (μ + 3) + 4 ≤ x ∧ x + 3 ≤ 6 * (μ + 3)) ∨ x + 2 = 6 * (μ + 3) ∨ x + 1 = 6 * (μ + 3) := by omega
  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z2_p0 hn
  · exact tr_z2_p1 hn
  · exact tr_z2_p2 hn
  · exact tr_z2_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 4 * (μ + 3)) with hp | hp
    · exact tr_z2_ge (n := (x - 4 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z2_go (n := (x - 4 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z2_gt (by omega)
  · exact tr_z2_l (by omega)

