  · obtain ⟨c, d, habc, hac, hp⟩ : ∃ a b, (a = b ∨ a = b + 1) ∧ a ≤ μ ∧ p = 22 * (μ + 3) + a + b + 4 :=
      ⟨(p - 22 * (μ + 3) - 3) / 2, (p - 22 * (μ + 3) - 4) / 2, by omega, by omega, by omega⟩
    have hw := ev_z11_g habc hac hp
    have lc : c ≤ μ + 1 := by omega
    have lc1 : c + 1 ≤ μ + 1 := by omega
    have ld : d ≤ μ + 1 := by omega
    have ld1 : d + 1 ≤ μ + 1 := by omega
    simp only [hw, tri_f_0_0, tri_f_1_0, tri_f_1_1, tri_f_2_0, tri_f_2_1, tri_f_2_2, tri_f_3_0, tri_f_3_1, tri_f_3_2, tri_f_3_3]
