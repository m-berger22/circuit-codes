lemma pbr_12_r2_12 {μ s p : ℕ} (h : s = 24 * (μ + 3) + 2) (hp1 : 24 * (μ + 3) ≤ p) (hp2 : p ≤ 24 * (μ + 3) + 2) (hsp : s ≤ p) :
    H (μ + 3) s p < 6 * (μ + 3) - 1 → H (μ + 3) s p = p - s := by
  rw [H_expand3]
  have hrp : p = 24 * (μ + 3) ∨ p = 24 * (μ + 3) + 1 ∨ p = 24 * (μ + 3) + 2 := by omega
  have hu := ev_z12_r2 h
  simp only [hu]
  clear hu
  rcases hrp with h' | h' | h'
  · have hw := ev_z12_r0 h'
    simp only [hw, tri_f_0_0, tri_f_1_0, tri_f_1_1, tri_f_2_0, tri_f_2_1, tri_f_2_2, tri_f_3_0, tri_f_3_1, tri_f_3_2, tri_f_3_3]
    clear hw
    simp only [min_c0, min_c1, min_cμ, min_cm, Nat.sub_zero, Nat.zero_sub, Nat.sub_self, add_zero, zero_add, Nat.reduceAdd, Nat.reduceMod, Nat.reduceSub]
    omega
  · have hw := ev_z12_r1 h'
    simp only [hw, tri_f_0_0, tri_f_1_0, tri_f_1_1, tri_f_2_0, tri_f_2_1, tri_f_2_2, tri_f_3_0, tri_f_3_1, tri_f_3_2, tri_f_3_3]
    clear hw
    simp only [min_c0, min_c1, min_cμ, min_cm, Nat.sub_zero, Nat.zero_sub, Nat.sub_self, add_zero, zero_add, Nat.reduceAdd, Nat.reduceMod, Nat.reduceSub]
    omega
  · have hw := ev_z12_r2 h'
    simp only [hw, tri_f_0_0, tri_f_1_0, tri_f_1_1, tri_f_2_0, tri_f_2_1, tri_f_2_2, tri_f_3_0, tri_f_3_1, tri_f_3_2, tri_f_3_3]
    clear hw
    simp only [min_c0, min_c1, min_cμ, min_cm, Nat.sub_zero, Nat.zero_sub, Nat.sub_self, add_zero, zero_add, Nat.reduceAdd, Nat.reduceMod, Nat.reduceSub]
    omega

lemma pb_12_12 {μ s p : ℕ} (hs1 : 24 * (μ + 3) ≤ s) (hs2 : s ≤ 24 * (μ + 3) + 2) (hp1 : 24 * (μ + 3) ≤ p) (hp2 : p ≤ 24 * (μ + 3) + 2) (hsp : s ≤ p) :
    H (μ + 3) s p < 6 * (μ + 3) - 1 → H (μ + 3) s p = p - s := by
  have hrs : s = 24 * (μ + 3) ∨ s = 24 * (μ + 3) + 1 ∨ s = 24 * (μ + 3) + 2 := by omega
  rcases hrs with h | h | h
  · exact pbr_12_r0_12 h hp1 hp2 hsp
  · exact pbr_12_r1_12 h hp1 hp2 hsp
  · exact pbr_12_r2_12 h hp1 hp2 hsp

end Coil.FamX
