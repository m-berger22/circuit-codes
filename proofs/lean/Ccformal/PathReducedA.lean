theorem noSolA : NoSol parA := by
  intro x0 x1 x2 x3 x4 x5 hx
  have hx' : x0 + x1 + x2 + x3 + x4 + x5 ≤ 0 := hx
  have e : 5 * parA.M = 20 := rfl
  rw [e]
  have b0 : x0 ≤ 0 := by omega
  have b1 : x1 ≤ 0 := by omega
  have b2 : x2 ≤ 0 := by omega
  have b3 : x3 ≤ 0 := by omega
  have b4 : x4 ≤ 0 := by omega
  have b5 : x5 ≤ 0 := by omega
  have := xA_000000
  clear hx
  interval_cases x0 <;> first | omega | (with_reducible assumption) | skip
  all_goals
    interval_cases x1 <;> first | omega | (with_reducible assumption) | skip
    all_goals
      interval_cases x2 <;> first | omega | (with_reducible assumption) | skip
      all_goals
        interval_cases x3 <;> first | omega | (with_reducible assumption) | skip
        all_goals
          interval_cases x4 <;> first | omega | (with_reducible assumption) | skip
          all_goals
            interval_cases x5 <;> first | omega | (with_reducible assumption) | skip

end Red

