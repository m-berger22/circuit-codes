lemma pb_2_11 {μ s p : ℕ} (hs1 : 4 * (μ + 3) ≤ s) (hs2 : s < 6 * (μ + 3)) (hp1 : 22 * (μ + 3) ≤ p) (hp2 : p < 24 * (μ + 3)) (hsp : s ≤ p) :
    H (μ + 3) s p < 6 * (μ + 3) - 1 → H (μ + 3) s p = p - s := by
  have hrs : s = 4 * (μ + 3) ∨ s = 4 * (μ + 3) + 1 ∨ s = 4 * (μ + 3) + 2 ∨ s = 4 * (μ + 3) + 3 ∨ (4 * (μ + 3) + 4 ≤ s ∧ s + 2 ≤ 6 * (μ + 3)) ∨ s + 1 = 6 * (μ + 3) := by omega
  rcases hrs with h | h | h | h | h | h
  · exact pbr_2_r0_11 h hp1 hp2 hsp
  · exact pbr_2_r1_11 h hp1 hp2 hsp
  · exact pbr_2_r2_11 h hp1 hp2 hsp
  · exact pbr_2_r3_11 h hp1 hp2 hsp
  · exact pbr_2_g_11 h hp1 hp2 hsp
  · exact pbr_2_l_11 h hp1 hp2 hsp

