/-- **The table of `k_max(l)`, `6 ≤ l ≤ 31`.** -/
theorem kmax_table (l : ℕ) (h6 : 6 ≤ l) (h15 : l ≤ 31) :
    (∃ n N, 2 * n = 3 * kmaxOf l + l + 1 ∧ 4 * kmaxOf l + 2 * l < N ∧
      ∃ v : ℕ → Fin n → Bool, IsCoil (kmaxOf l) N v) ∧
    ∀ k n, kmaxOf l < k → 2 * n = 3 * k + l + 1 → IsMaxLength n k (4 * k + 2 * l) :=
  ⟨kmax_table_at l h6 h15, fun k n hk hn => kmax_table_beyond l h6 h15 k n hk hn⟩

end Coil

