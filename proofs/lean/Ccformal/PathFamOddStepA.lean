lemma stepCA {K m s y : ℕ} (hK : K % 2 = 1) (hm : m % 2 = 1) (hKm : 2 * m ≤ K + 1) (hs : s ≤ K)
    (hy : y < K + m) :
    (¬ dnC K m s y → HCA K m s (y + 1) = HCA K m s y + 1)
      ∧ (dnC K m s y → K ≤ HCA K m s y ∧ HCA K m s (y + 1) + 1 = HCA K m s y) := by
  rcases Nat.lt_or_ge y m with hy1 | hy1
  · rcases Nat.lt_or_ge (y + 1) m with e3 | e3
    · have f0 : y < m := by omega
      have f1 : y + 1 < m := by omega
      simp only [dnC, HCA, EC, f0, f1, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · rcases Nat.lt_or_ge (y + 1 + 2) (3 * m) with e4 | e4
      · have f0 : y < m := by omega
        have f1 : ¬ (y + 1 < m) := by omega
        have f2 : y + 1 + 2 < 3 * m := by omega
        have f3 : (y + 1 - m) % 4 = 0 := by omega
        have f4 : (y + 1 - m) / 4 = 0 := by omega
        simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have f0 : y < m := by omega
        have f1 : ¬ (y + 1 < m) := by omega
        have f2 : ¬ (y + 1 + 2 < 3 * m) := by omega
        have f3 : y + 1 < K + m := by omega
        simp only [dnC, HCA, EC, f0, f1, f2, f3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
  rcases Nat.lt_or_ge (y + 2) (3 * m) with hy2 | hy2
  · have h4 : (y - m) % 4 = 0 ∨ (y - m) % 4 = 1 ∨ (y - m) % 4 = 2 ∨ (y - m) % 4 = 3 := by omega
    rcases h4 with h4 | h4 | h4 | h4
    · have f0 : ¬ (y < m) := by omega
      have f1 : ¬ (y + 1 < m) := by omega
      have f2 : y + 2 < 3 * m := by omega
      have f3 : (y - m) % 4 = 0 := by omega
      have f4 : (y + 1 - m) % 4 = 1 := by omega
      have f5 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
      have f6 : y + 1 + 2 < 3 * m := by omega
      simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, f6, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have f0 : ¬ (y < m) := by omega
      have f1 : ¬ (y + 1 < m) := by omega
      have f2 : y + 2 < 3 * m := by omega
      have f3 : (y - m) % 4 = 1 := by omega
      have f4 : (y + 1 - m) % 4 = 2 := by omega
      have f5 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
      have f6 : y + 1 + 2 < 3 * m := by omega
      simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, f6, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have f0 : ¬ (y < m) := by omega
      have f1 : ¬ (y + 1 < m) := by omega
      have f2 : y + 2 < 3 * m := by omega
      have f3 : (y - m) % 4 = 2 := by omega
      have f4 : (y + 1 - m) % 4 = 3 := by omega
      have f5 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
      have f6 : y + 1 + 2 < 3 * m := by omega
      simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, f6, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · rcases Nat.lt_or_ge (y + 1 + 2) (3 * m) with e3 | e3
      · have f0 : ¬ (y < m) := by omega
        have f1 : ¬ (y + 1 < m) := by omega
        have f2 : y + 2 < 3 * m := by omega
        have f3 : (y - m) % 4 = 3 := by omega
        have f4 : (y + 1 - m) % 4 = 0 := by omega
        have f5 : (y + 1 - m) / 4 = (y - m) / 4 + 1 := by omega
        have f6 : y + 1 + 2 < 3 * m := by omega
        simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, f6, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have f0 : ¬ (y < m) := by omega
        have f1 : ¬ (y + 1 < m) := by omega
        have f2 : y + 2 < 3 * m := by omega
        have f3 : (y - m) % 4 = 3 := by omega
        have f4 : ¬ (y + 1 + 2 < 3 * m) := by omega
        have f5 : y + 1 < K + m := by omega
        simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
  rcases Nat.lt_or_ge (y + 1) (K + m) with hy3 | hy3
  · have f0 : ¬ (y < m) := by omega
    have f1 : ¬ (y + 1 < m) := by omega
    have f2 : ¬ (y + 2 < 3 * m) := by omega
    have f3 : ¬ (y + 1 + 2 < 3 * m) := by omega
    have f4 : y < K + m := by omega
    have f5 : y + 1 < K + m := by omega
    simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
    split_ifs <;> first | omega | contradiction
  · have f0 : ¬ (y < m) := by omega
    have f1 : ¬ (y + 1 < m) := by omega
    have f2 : ¬ (y + 2 < 3 * m) := by omega
    have f3 : ¬ (y + 1 + 2 < 3 * m) := by omega
    have f4 : y < K + m := by omega
    have f5 : ¬ (y + 1 < K + m) := by omega
    have f6 : y % 2 = 1 := by omega
    simp only [dnC, HCA, EC, f0, f1, f2, f3, f4, f5, f6, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
    split_ifs <;> first | omega | contradiction

