lemma stepDA {K m s w : ℕ} (hK : K % 2 = 1) (hm : m % 2 = 1) (hKm : 2 * m ≤ K + 1) (hs : s ≤ K)
    (hw : w + 2 ≤ 2 * m) :
    (¬ dnD K m s w → HDA K m s (w + 1) = HDA K m s w + 1)
      ∧ (dnD K m s w → K ≤ HDA K m s w ∧ HDA K m s (w + 1) + 1 = HDA K m s w) := by
  have h4 : w % 4 = 0 ∨ w % 4 = 1 ∨ w % 4 = 2 ∨ w % 4 = 3 := by omega
  rcases Nat.lt_or_ge (w + 2) (2 * m) with hw1 | hw1
  · rcases h4 with h4 | h4 | h4 | h4
    · have f0 : w % 4 = 0 := by omega
      have f1 : (w + 1) % 4 = 1 := by omega
      have f2 : (w + 1) / 4 = w / 4 := by omega
      have f3 : w + 2 < 2 * m := by omega
      have f4 : w + 1 + 2 < 2 * m := by omega
      simp only [dnD, HDA, EC, f0, f1, f2, f3, f4, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have f0 : w % 4 = 1 := by omega
      have f1 : (w + 1) % 4 = 2 := by omega
      have f2 : (w + 1) / 4 = w / 4 := by omega
      have f3 : w + 2 < 2 * m := by omega
      have f4 : w + 1 + 2 < 2 * m := by omega
      simp only [dnD, HDA, EC, f0, f1, f2, f3, f4, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have f0 : w % 4 = 2 := by omega
      have f1 : (w + 1) % 4 = 3 := by omega
      have f2 : (w + 1) / 4 = w / 4 := by omega
      have f3 : w + 2 < 2 * m := by omega
      have f4 : w + 1 + 2 < 2 * m := by omega
      simp only [dnD, HDA, EC, f0, f1, f2, f3, f4, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · rcases Nat.lt_or_ge (w + 1 + 2) (2 * m) with e3 | e3
      · have f0 : w % 4 = 3 := by omega
        have f1 : (w + 1) % 4 = 0 := by omega
        have f2 : (w + 1) / 4 = w / 4 + 1 := by omega
        have f3 : w + 2 < 2 * m := by omega
        have f4 : w + 1 + 2 < 2 * m := by omega
        simp only [dnD, HDA, EC, f0, f1, f2, f3, f4, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have f0 : w % 4 = 3 := by omega
        have f1 : (w + 1) % 4 = 0 := by omega
        have f2 : (w + 1) / 4 = w / 4 + 1 := by omega
        have f3 : w + 2 < 2 * m := by omega
        have f4 : ¬ (w + 1 + 2 < 2 * m) := by omega
        have f5 : w + 1 + 2 = 2 * m := by omega
        simp only [dnD, HDA, EC, f0, f1, f2, f3, f4, f5, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
  · have f0 : w % 4 = 0 := by omega
    have f1 : ¬ (w + 2 < 2 * m) := by omega
    have f2 : w + 2 = 2 * m := by omega
    have f3 : ¬ (w + 1 + 2 < 2 * m) := by omega
    have f4 : ¬ (w + 1 + 2 = 2 * m) := by omega
    simp only [dnD, HDA, EC, f0, f1, f2, f3, f4, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
    split_ifs <;> first | omega | contradiction

