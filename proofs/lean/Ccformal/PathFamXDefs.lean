/-! contributions of complete / untouched streams (simp set of the `ev` lemmas) -/
lemma cf_l0 (μ : ℕ) : min (μ + 3) 1 = 1 := by omega
lemma cf_l1 (μ : ℕ) : min (μ + 3 - 1) 1 = 1 := by omega
lemma cf_m1 (μ : ℕ) : min (μ + 3 - 1) (μ + 3 - 2) = μ + 1 := by omega
lemma cf_m2 (μ : ℕ) : min (μ + 3 - 2) (μ + 3 - 2) = μ + 1 := by omega
lemma cf_h (μ : ℕ) : μ + 3 - (μ + 3 - 1) = 1 := by omega
lemma cz_l0 : min 0 1 = 0 := by omega
lemma cz_l1 : min (0 - 1) 1 = 0 := by omega
lemma cz_m1 (μ : ℕ) : min (0 - 1) (μ + 3 - 2) = 0 := by omega
lemma cz_m2 (μ : ℕ) : min (0 - 2) (μ + 3 - 2) = 0 := by omega
lemma cz_h (μ : ℕ) : 0 - (μ + 3 - 1) = 0 := by omega

lemma min_c0 (μ : ℕ) : min 0 (μ + 1) = 0 := by omega
lemma min_c1 (μ : ℕ) : min 1 (μ + 1) = 1 := by omega
lemma min_cμ (μ : ℕ) : min μ (μ + 1) = μ := by omega
lemma min_cm (μ : ℕ) : min (μ + 1) (μ + 1) = μ + 1 := by omega

