import Ccformal.PathWalk

/-!
# The even family fam(k, m) of spread-k paths: definitions      (S178)

`K = 2κ`, `m = 2h`, `k + 1 = K`, `K ≥ 2m`.  Word `famT κ h` of length `L = 3K + 3m + 1` over `d = 3κ + h` letters,
down-step predicate `dn` (Sign Table of PROOF_family.md) and height function `H`.
A python twin of these definitions was brute-force tested first (not included).
STATUS: everything PROVED (no `sorry`). The step lemmas `stepCA … stepDC` at the end are generated by a script (not included).
-/

open Finset

namespace Coil

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSimpArgs false
set_option linter.unreachableTactic false
set_option linter.style.longLine false

/-- the word, by position -/
def famT (κ h p : ℕ) : ℕ :=
  if p < 2 * κ then p
  else if p < 4 * κ then (if (p - 2 * κ) % 2 = 0 then p - 2 * κ else 2 * κ + (p - 2 * κ) / 2)
  else if p < 4 * κ + 2 * h then p - 4 * κ
  else if p < 4 * κ + 6 * h then
    (if (p - 4 * κ - 2 * h) % 4 = 0 then 3 * κ + (p - 4 * κ - 2 * h) / 4
     else if (p - 4 * κ - 2 * h) % 4 = 1 then 2 * κ + h + (p - 4 * κ - 2 * h) / 4
     else if (p - 4 * κ - 2 * h) % 4 = 2 then 2 * h + 2 * ((p - 4 * κ - 2 * h) / 4)
     else 2 * h + 2 * ((p - 4 * κ - 2 * h) / 4) + 1)
  else if p < 6 * κ + 2 * h then p - 4 * κ - 2 * h
  else if p < 6 * κ + 6 * h then
    (if (p - 6 * κ - 2 * h) % 4 = 0 then 2 * ((p - 6 * κ - 2 * h) / 4)
     else if (p - 6 * κ - 2 * h) % 4 = 1 then 2 * κ + h + (p - 6 * κ - 2 * h) / 4
     else if (p - 6 * κ - 2 * h) % 4 = 2 then 2 * ((p - 6 * κ - 2 * h) / 4) + 1
     else 2 * κ + (p - 6 * κ - 2 * h) / 4)
  else 2 * h

lemma famT_lt {κ h : ℕ} (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) (p : ℕ) : famT κ h p < 3 * κ + h := by
  unfold famT
  split_ifs <;> omega

/-- the word with letters in `Fin (3κ + h)` -/
def famF (κ h : ℕ) (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) : ℕ → Fin (3 * κ + h) :=
  fun p => ⟨famT κ h p, famT_lt hκ hh p⟩

lemma famF_eq_iff {κ h : ℕ} (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) (i j : ℕ) :
    famF κ h hκ hh i = famF κ h hκ hh j ↔ famT κ h i = famT κ h j := by
  simp [famF, Fin.ext_iff]

/-! ### down-step predicate (Sign Table) -/

def dnB (s x : ℕ) : Prop := x % 2 = 0 ∧ s ≤ x

def dnC (K m s y : ℕ) : Prop :=
  if y < m then (if y % 2 = 0 then (y < s ∧ s ≤ K + y) else s ≤ y)
  else if y < 3 * m then
    (if (y - m) % 4 = 0 then False
     else if (y - m) % 4 = 1 then s ≤ K + m + 2 * ((y - m) / 4) + 1
     else if (y - m) % 4 = 2 then (m + 2 * ((y - m) / 4) < s ∧ s ≤ K + m + 2 * ((y - m) / 4))
     else s ≤ m + 2 * ((y - m) / 4) + 1)
  else (if y % 2 = 0 then (y < s + m ∧ s + m ≤ K + y) else s + m ≤ y)

def dnD (K m s z : ℕ) : Prop :=
  if z < 2 * m then
    (if z % 4 = 0 then (s ≤ 2 * (z / 4) ∨ (K + 2 * (z / 4) < s ∧ s ≤ 2 * K + 2 * (z / 4)))
     else if z % 4 = 1 then (K + m + 2 * (z / 4) + 1 < s ∧ s ≤ 2 * K + m + 4 * (z / 4) + 1)
     else if z % 4 = 2 then (2 * (z / 4) + 1 < s ∧ s ≤ 2 * K + 2 * (z / 4) + 1)
     else s ≤ K + 2 * (z / 4) + 1)
  else if 0 < m then (s ≤ m ∨ (K + m < s ∧ s ≤ 2 * K + m + 2))
  else (s = 0 ∨ (K < s ∧ s ≤ 2 * K))

def dn (κ h s j : ℕ) : Prop :=
  (2 * κ ≤ j ∧ j < 4 * κ ∧ dnB s (j - 2 * κ))
  ∨ (4 * κ ≤ j ∧ j < 6 * κ + 2 * h ∧ dnC (2 * κ) (2 * h) s (j - 4 * κ))
  ∨ (6 * κ + 2 * h ≤ j ∧ dnD (2 * κ) (2 * h) s (j - (6 * κ + 2 * h)))

lemma dn_A {κ h s j : ℕ} (hj : j < 2 * κ) : ¬ dn κ h s j := by
  unfold dn; omega

lemma dn_B {κ h s j : ℕ} (h1 : 2 * κ ≤ j) (h2 : j < 4 * κ) : dn κ h s j ↔ dnB s (j - 2 * κ) := by
  unfold dn
  constructor
  · rintro (⟨_, _, h⟩ | ⟨_, _, _⟩ | ⟨_, _⟩)
    · exact h
    · omega
    · omega
  · intro h; exact Or.inl ⟨h1, h2, h⟩

lemma dn_C {κ h s j : ℕ} (h1 : 4 * κ ≤ j) (h2 : j < 6 * κ + 2 * h) :
    dn κ h s j ↔ dnC (2 * κ) (2 * h) s (j - 4 * κ) := by
  unfold dn
  constructor
  · rintro (⟨_, _, _⟩ | ⟨_, _, h⟩ | ⟨_, _⟩)
    · omega
    · exact h
    · omega
  · intro h; exact Or.inr (Or.inl ⟨h1, h2, h⟩)

lemma dn_D {κ h s j : ℕ} (h1 : 6 * κ + 2 * h ≤ j) :
    dn κ h s j ↔ dnD (2 * κ) (2 * h) s (j - (6 * κ + 2 * h)) := by
  unfold dn
  constructor
  · rintro (⟨_, _, _⟩ | ⟨_, _, _⟩ | ⟨_, h⟩)
    · omega
    · omega
    · exact h
  · intro h; exact Or.inr (Or.inr ⟨h1, h⟩)

/-! ### height function -/

def HBA (K s x : ℕ) : ℕ := if x ≤ s then K + x - s else K + s % 2 - x % 2

def HCA (K m s y : ℕ) : ℕ :=
  if y < m then (if y < s + y % 2 then K + s % 2 - y % 2 else K + y % 2 - s % 2)
  else if y < 3 * m then
    (if m + 2 * ((y - m) / 4) < s then K + s % 2 + (1 + (y - m) % 4 % 2) - 2 * ((y - m) % 4 / 3) - 1
     else K + (y - m) % 4 % 2 - s % 2)
  else (if y < s + m + y % 2 then K + s % 2 - y % 2 else K + y % 2 - s % 2)

def HDA (K m s z : ℕ) : ℕ :=
  if z < 2 * m then
    (if 2 * (z / 4) + 1 < s then K + z % 4 - 2 * (z % 4 / 3) - s % 2
     else if 2 * (z / 4) + 1 = s then K + z % 4 - 1
     else K + s % 2 + (1 + 2 * (z % 4 / 3)) - z % 4 % 2 - 1)
  else if z = 2 * m then (if s % 2 = 0 then K else if s < m then K + 1 else K - 1)
  else (if s % 2 = 0 then (if s ≤ m then K - 1 else K + 1) else K)

def EC (K m t : ℕ) : ℕ := if t ≤ m then K + t % 2 else if t ≤ 2 * m then K + t - m else K + m + t % 2

def HCB (K m t y : ℕ) : ℕ :=
  if y < m then (if y < t + y % 2 then K + y - t else EC K m t - y % 2)
  else if y < 3 * m then
    (if t ≤ m + 2 * ((y - m) / 4) then EC K m t + (1 + (y - m) % 4 % 2) - 2 * ((y - m) % 4 / 3) - 1
     else if t = m + 2 * ((y - m) / 4) + 1 then K + t + (y - m) % 4 % 2 - (m + 2)
     else K + y - t)
  else (if y < t + m + y % 2 then K + y - t else EC K m t - y % 2)

def HDB (K m t z : ℕ) : ℕ :=
  if z < 2 * m then
    (if t ≤ 2 * (z / 4) then K + z % 4 - 2 * (z % 4 / 3) - t % 2
     else if t = 2 * (z / 4) + 1 then K + 1 - z % 4 % 2
     else if t ≤ m + 2 * (z / 4) + 1 then K + t % 2 + 1 - z % 4 % 2 - 1
     else EC K m t - (2 * (z / 4) + z % 4))
  else if z = 2 * m then (if t ≤ m then K - t % 2 else K + t % 2)
  else (if t ≤ m then K + 1 - t % 2 else K + t % 2 - 1)

def HDC (K m u z : ℕ) : ℕ :=
  if z < 2 * m then
    (if u ≤ 2 * (z / 4) then K + m + u - (2 * (z / 4) + z % 4)
     else if u = 2 * (z / 4) + 1 then K + m + (1 + z % 4 % 2) - 2 * (z % 4 / 3) - 2
     else if u ≤ m + 4 * (z / 4) + 1 then K + m + 2 * (z / 4) + 2 * min (m / 2) ((u + 2 - m) / 4) + z % 4 % 2 - u
     else K + m + z - u)
  else if z = 2 * m then (if u ≤ m then K + u else K + 2 * m + 2 * min (m / 2) ((u + 2 - m) / 4) - u)
  else if (0 < m ∧ u ≤ m + 2) ∨ (m = 0 ∧ u = 0) then
    (if u ≤ m then K + u - 1 else K + 2 * m + 2 * min (m / 2) ((u + 2 - m) / 4) - (u + 1))
  else (if u ≤ m then K + u + 1 else K + 2 * m + 2 * min (m / 2) ((u + 2 - m) / 4) + 1 - u)

def H (κ h s p : ℕ) : ℕ :=
  if s < 2 * κ then
    (if p ≤ 2 * κ then p - s
     else if p ≤ 4 * κ then HBA (2 * κ) s (p - 2 * κ)
     else if p ≤ 6 * κ + 2 * h then HCA (2 * κ) (2 * h) s (p - 4 * κ)
     else HDA (2 * κ) (2 * h) s (p - (6 * κ + 2 * h)))
  else if s < 4 * κ then
    (if p ≤ 4 * κ then p - s
     else if p ≤ 6 * κ + 2 * h then HCB (2 * κ) (2 * h) (s - 2 * κ) (p - 4 * κ)
     else HDB (2 * κ) (2 * h) (s - 2 * κ) (p - (6 * κ + 2 * h)))
  else if s < 6 * κ + 2 * h then
    (if p ≤ 6 * κ + 2 * h then p - s
     else HDC (2 * κ) (2 * h) (s - 4 * κ) (p - (6 * κ + 2 * h)))
  else p - s

/-! ### from occurrences to the parity of the count -/

lemma odd3 (A B C : Prop) [Decidable A] [Decidable B] [Decidable C] :
    Odd ((if A then 1 else 0) + (if B then 1 else 0) + (if C then 1 else 0))
      ↔ ((A ∧ ¬ B ∧ ¬ C) ∨ (¬ A ∧ B ∧ ¬ C) ∨ (¬ A ∧ ¬ B ∧ C) ∨ (A ∧ B ∧ C)) := by
  by_cases a : A <;> by_cases b : B <;> by_cases c : C <;> simp [a, b, c] <;> decide

/-- one row of the Sign Table: letter value `v` at `j`, earlier occurrences among `p1, p2, p3` (dummies `≥ j`). -/
lemma hdn_of {κ h : ℕ} (hκ : 1 ≤ κ) (hh : 2 * h ≤ κ) {s j v p1 p2 p3 : ℕ} (hsj : s ≤ j)
    (hv : famT κ h j = v)
    (hocc : ∀ i, i < j → (famT κ h i = v ↔ i = p1 ∨ i = p2 ∨ i = p3))
    (h12 : p1 ≠ p2) (h13 : p1 ≠ p3) (h23 : p2 ≠ p3)
    (hD : dn κ h s j ↔ (((s ≤ p1 ∧ p1 < j) ∧ ¬ (s ≤ p2 ∧ p2 < j) ∧ ¬ (s ≤ p3 ∧ p3 < j))
      ∨ (¬ (s ≤ p1 ∧ p1 < j) ∧ (s ≤ p2 ∧ p2 < j) ∧ ¬ (s ≤ p3 ∧ p3 < j))
      ∨ (¬ (s ≤ p1 ∧ p1 < j) ∧ ¬ (s ≤ p2 ∧ p2 < j) ∧ (s ≤ p3 ∧ p3 < j))
      ∨ ((s ≤ p1 ∧ p1 < j) ∧ (s ≤ p2 ∧ p2 < j) ∧ (s ≤ p3 ∧ p3 < j)))) :
    Odd (cnt (famF κ h hκ hh) s (j - s) (famF κ h hκ hh j)) ↔ dn κ h s j := by
  have e : s + (j - s) = j := by omega
  have hc := cnt_three (T := famF κ h hκ hh) (s := s) (w := j - s) (c := famF κ h hκ hh j) h12 h13 h23
    (by
      intro i _ hi
      rw [famF_eq_iff, hv]
      exact hocc i (by omega))
  rw [hc, e, hD, odd3]

/-! ### step lemmas, one per (block of s, block of j)   (generated by a script) -/

lemma stepBA {K s x : ℕ} (hK : K % 2 = 0) (hs : s < K) (hx : x < K) :
    (¬ dnB s x → HBA K s (x + 1) = HBA K s x + 1)
      ∧ (dnB s x → K ≤ HBA K s x ∧ HBA K s (x + 1) + 1 = HBA K s x) := by
  unfold dnB HBA
  split_ifs <;> omega

lemma stepCA {K m s y : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (hs : s < K)
    (hy : y < K + m) :
    (¬ dnC K m s y → HCA K m s (y + 1) = HCA K m s y + 1)
      ∧ (dnC K m s y → K ≤ HCA K m s y ∧ HCA K m s (y + 1) + 1 = HCA K m s y) := by
  rcases Nat.lt_or_ge y m with hy1 | hy1
  · rcases Nat.lt_or_ge (y + 1) m with e3 | e3
    · simp only [dnC, HCA, EC, hy1, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have e4 : ¬ (y + 1 < m) := by omega
      have e5 : y + 1 < 3 * m := by omega
      have e6 : (y + 1 - m) % 4 = 0 := by omega
      have e7 : (y + 1 - m) / 4 = 0 := by omega
      simp only [dnC, HCA, EC, hy1, e4, e5, e6, e7, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
  · have e0 : ¬ (y < m) := by omega
    have e4 : ¬ (y + 1 < m) := by omega
    rcases Nat.lt_or_ge y (3 * m) with hy2 | hy2
    · have h4 : (y - m) % 4 = 0 ∨ (y - m) % 4 = 1 ∨ (y - m) % 4 = 2 ∨ (y - m) % 4 = 3 := by omega
      rcases h4 with h4 | h4 | h4 | h4
      · have e1 : (y + 1 - m) % 4 = 1 := by omega
        have e2 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
        have e3 : y + 1 < 3 * m := by omega
        simp only [dnC, HCA, EC, e0, e4, hy2, h4, e1, e2, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have e1 : (y + 1 - m) % 4 = 2 := by omega
        have e2 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
        have e3 : y + 1 < 3 * m := by omega
        simp only [dnC, HCA, EC, e0, e4, hy2, h4, e1, e2, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have e1 : (y + 1 - m) % 4 = 3 := by omega
        have e2 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
        have e3 : y + 1 < 3 * m := by omega
        simp only [dnC, HCA, EC, e0, e4, hy2, h4, e1, e2, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · rcases Nat.lt_or_ge (y + 1) (3 * m) with e3 | e3
        · have e1 : (y + 1 - m) % 4 = 0 := by omega
          have e2 : (y + 1 - m) / 4 = (y - m) / 4 + 1 := by omega
          simp only [dnC, HCA, EC, e0, e4, hy2, h4, e1, e2, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
          split_ifs <;> first | omega | contradiction
        · have e5 : ¬ (y + 1 < 3 * m) := by omega
          simp only [dnC, HCA, EC, e0, e4, hy2, h4, e5, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
          split_ifs <;> first | omega | contradiction
    · have e5 : ¬ (y < 3 * m) := by omega
      have e6 : ¬ (y + 1 < 3 * m) := by omega
      simp only [dnC, HCA, EC, e0, e4, e5, e6, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction

lemma stepDA {K m s z : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (hs : s < K)
    (hz : z ≤ 2 * m) :
    (¬ dnD K m s z → HDA K m s (z + 1) = HDA K m s z + 1)
      ∧ (dnD K m s z → K ≤ HDA K m s z ∧ HDA K m s (z + 1) + 1 = HDA K m s z) := by
  rcases Nat.lt_or_ge z (2 * m) with hz1 | hz1
  · have h4 : z % 4 = 0 ∨ z % 4 = 1 ∨ z % 4 = 2 ∨ z % 4 = 3 := by omega
    rcases h4 with h4 | h4 | h4 | h4
    · have e1 : (z + 1) % 4 = 1 := by omega
      have e2 : (z + 1) / 4 = z / 4 := by omega
      have e3 : z + 1 < 2 * m := by omega
      simp only [dnD, HDA, EC, h4, e1, e2, hz1, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have e1 : (z + 1) % 4 = 2 := by omega
      have e2 : (z + 1) / 4 = z / 4 := by omega
      have e3 : z + 1 < 2 * m := by omega
      simp only [dnD, HDA, EC, h4, e1, e2, hz1, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have e1 : (z + 1) % 4 = 3 := by omega
      have e2 : (z + 1) / 4 = z / 4 := by omega
      have e3 : z + 1 < 2 * m := by omega
      simp only [dnD, HDA, EC, h4, e1, e2, hz1, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have e1 : (z + 1) % 4 = 0 := by omega
      have e2 : (z + 1) / 4 = z / 4 + 1 := by omega
      rcases Nat.lt_or_ge (z + 1) (2 * m) with e3 | e3
      · simp only [dnD, HDA, EC, h4, e1, e2, hz1, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have e4 : ¬ (z + 1 < 2 * m) := by omega
        have e5 : z + 1 = 2 * m := by omega
        simp only [dnD, HDA, EC, h4, hz1, e4, e5, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
  · obtain rfl : z = 2 * m := by omega
    have e0 : ¬ (2 * m < 2 * m) := by omega
    have e4 : ¬ (2 * m + 1 < 2 * m) := by omega
    have e5 : ¬ (2 * m + 1 = 2 * m) := by omega
    simp only [dnD, HDA, EC, e0, e4, e5, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
    split_ifs <;> first | omega | contradiction

lemma stepCB {K m t y : ℕ} (hK : K % 2 = 0) (hm : m % 2 = 0) (hKm : 2 * m ≤ K) (hK2 : 2 ≤ K) (ht : t < K)
    (hy : y < K + m) :
    (¬ dnC K m (K + t) y → HCB K m t (y + 1) = HCB K m t y + 1)
      ∧ (dnC K m (K + t) y → K ≤ HCB K m t y ∧ HCB K m t (y + 1) + 1 = HCB K m t y) := by
  rcases Nat.lt_or_ge y m with hy1 | hy1
  · rcases Nat.lt_or_ge (y + 1) m with e3 | e3
    · simp only [dnC, HCB, EC, hy1, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
    · have e4 : ¬ (y + 1 < m) := by omega
      have e5 : y + 1 < 3 * m := by omega
      have e6 : (y + 1 - m) % 4 = 0 := by omega
      have e7 : (y + 1 - m) / 4 = 0 := by omega
      simp only [dnC, HCB, EC, hy1, e4, e5, e6, e7, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
      split_ifs <;> first | omega | contradiction
  · have e0 : ¬ (y < m) := by omega
    have e4 : ¬ (y + 1 < m) := by omega
    rcases Nat.lt_or_ge y (3 * m) with hy2 | hy2
    · have h4 : (y - m) % 4 = 0 ∨ (y - m) % 4 = 1 ∨ (y - m) % 4 = 2 ∨ (y - m) % 4 = 3 := by omega
      rcases h4 with h4 | h4 | h4 | h4
      · have e1 : (y + 1 - m) % 4 = 1 := by omega
        have e2 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
        have e3 : y + 1 < 3 * m := by omega
        simp only [dnC, HCB, EC, e0, e4, hy2, h4, e1, e2, e3, ↓reduceIte, not_false_eq_true, false_imp_iff, true_imp_iff, and_true, Nat.reduceDiv, Nat.reduceMod, Nat.reduceMul, Nat.reduceAdd, Nat.reduceEqDiff]
        split_ifs <;> first | omega | contradiction
      · have e1 : (y + 1 - m) % 4 = 2 := by omega
        have e2 : (y + 1 - m) / 4 = (y - m) / 4 := by omega
