  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z11_p0 hn
  · exact tr_z11_p1 hn
  · exact tr_z11_p2 hn
  · exact tr_z11_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 22 * (μ + 3)) with hp | hp
    · exact tr_z11_ge (n := (x - 22 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z11_go (n := (x - 22 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z11_gt (by omega)
  · exact tr_z11_l (by omega)

