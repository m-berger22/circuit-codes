lemma trans_z8 {μ x : ℕ} (h1 : 16 * (μ + 3) ≤ x) (h2 : x < 18 * (μ + 3)) : Trans (μ + 3) x := by
  have hn : x = 16 * (μ + 3) ∨ x = 16 * (μ + 3) + 1 ∨ x = 16 * (μ + 3) + 2 ∨ x = 16 * (μ + 3) + 3 ∨ (16 * (μ + 3) + 4 ≤ x ∧ x + 3 ≤ 18 * (μ + 3)) ∨ x + 2 = 18 * (μ + 3) ∨ x + 1 = 18 * (μ + 3) := by omega
  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z8_p0 hn
  · exact tr_z8_p1 hn
  · exact tr_z8_p2 hn
  · exact tr_z8_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 16 * (μ + 3)) with hp | hp
    · exact tr_z8_ge (n := (x - 16 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z8_go (n := (x - 16 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z8_gt (by omega)
  · exact tr_z8_l (by omega)

