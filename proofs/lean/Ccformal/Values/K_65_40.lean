def W_65_40 : ℕ := 

def f_65_40 (i : ℕ) : ℕ := (W_65_40 >>> (16 * i)) &&& 0xFFFF

theorem ok_65_40_0 : ∀ t < 0, okAt f_65_40 65 40 180 t = true := allRange_zero

theorem blk_65_40_0 : allRange (okAt f_65_40 65 40 180) 0 111 = true := by decide +kernel
theorem ok_65_40_111 : ∀ t < 111, okAt f_65_40 65 40 180 t = true := allRange_extend ok_65_40_0 blk_65_40_0
theorem blk_65_40_111 : allRange (okAt f_65_40 65 40 180) 111 69 = true := by decide +kernel
theorem ok_65_40_180 : ∀ t < 180, okAt f_65_40 65 40 180 t = true := allRange_extend ok_65_40_111 blk_65_40_111

theorem coil_65_40 : ∃ v : ℕ → Fin 65 → Bool, IsCoil 40 180 v :=
