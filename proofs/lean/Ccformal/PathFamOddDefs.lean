    ∨ (a5 ≤ p ∧ p < a6 ∧ (p - a5) % 4 = 1 ∧ famG z K nN nn mm e a1 a2 a3 a4 a5 a6 a7 a8 a9 p = nn + (p - a5) / 4)
    ∨ (a5 ≤ p ∧ p < a6 ∧ (p - a5) % 4 = 2 ∧ famG z K nN nn mm e a1 a2 a3 a4 a5 a6 a7 a8 a9 p = mm + 2 * ((p - a5) / 4))
