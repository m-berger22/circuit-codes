  rcases hn with hn | hn | hn | hn | hn | hn | hn
  · exact tr_z10_p0 hn
  · exact tr_z10_p1 hn
  · exact tr_z10_p2 hn
  · exact tr_z10_p3 hn
  · rcases Nat.mod_two_eq_zero_or_one (x - 20 * (μ + 3)) with hp | hp
    · exact tr_z10_ge (n := (x - 20 * (μ + 3) - 4) / 2) (by omega) (by omega)
    · exact tr_z10_go (n := (x - 20 * (μ + 3) - 5) / 2) (by omega) (by omega)
  · exact tr_z10_gt (by omega)
  · exact tr_z10_l (by omega)

